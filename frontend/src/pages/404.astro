---
import Base from '../layouts/Base.astro';
---
<Base lang="ka" title="404">
  <section class="wrap nf">
    <p class="display t-4xl">404</p>
    <p class="lead">გვერდი ვერ მოიძებნა. · Page not found.</p>
    <a class="btn btn-solid" href="/">მთავარი</a>
  </section>
</Base>
<style>
  .nf { min-height: 60vh; display: grid; align-content: center; justify-items: start; gap: var(--s-3); padding-block: var(--s-6); }
</style>
