---
import Wordmark from './Wordmark.astro';
import { type Lang, useT, path, altPath } from '../i18n/ui';

interface Props { lang: Lang; current: string }
const { lang, current } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'ka' ? 'en' : 'ka';
const links = [
  { key: 'home', href: path(lang, '/'), label: t('nav.home') },
  { key: 'products', href: path(lang, '/products/'), label: t('nav.products') },
  { key: 'about', href: path(lang, '/about/'), label: t('nav.about') },
  { key: 'contact', href: path(lang, '/contact/'), label: t('nav.contact') },
];
const menuLinks = links;
const switchHref = altPath(Astro.url.pathname, other);
const SLATS = 8;
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={path(lang, '/')} aria-label={`Symmetry, ${t('nav.home')}`}>
      <Wordmark />
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="tools">
      <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={t('lang.switch')} data-lang-switch data-on={lang}>
        <span class="opt" data-opt="ka">KA</span>
        <span class="opt" data-opt="en">EN</span>
      </a>
      <button class="menu-btn" type="button" data-menu-btn aria-expanded="false" aria-controls="site-menu"
        data-open-label={t('nav.menu')} data-close-label={t('nav.close')} aria-label={t('nav.menu')}>
        <span class="burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: opens below the header (the logo is never covered). Slats drop in, links rise. -->
<div class="menu" id="site-menu" data-menu hidden>
  <div class="menu-slats" aria-hidden="true">
    {Array.from({ length: SLATS }, (_, i) => <span style={`--i:${i}`} />)}
  </div>
  <nav class="menu-nav wrap" aria-label="Mobile">
    {menuLinks.map((l, i) => (
      <a href={l.href} style={`--j:${i}`} aria-current={current === l.key ? 'page' : undefined}>
        <span class="mi-label">{l.label}</span>
        <span class="mi-arrow" aria-hidden="true">→</span>
      </a>
    ))}
    <a class="menu-lang" href={switchHref} hreflang={other} lang={other} style={`--j:${menuLinks.length}`}>{t('lang.switch')}</a>
  </nav>
</div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 60;
    transition: background-color 400ms ease, border-color 400ms ease;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled], .site-header[data-menu-open] {
    background: color-mix(in oklab, var(--ground) 92%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-color: color-mix(in oklab, var(--line) 70%, transparent);
  }
  .site-header[data-menu-open] { background: var(--ground); }
  .bar { display: flex; align-items: center; gap: clamp(1rem, 0.5rem + 2vw, 2.5rem); height: var(--header-h); }
  .brand { text-decoration: none; display: inline-flex; }
  .nav { display: flex; align-items: center; gap: clamp(1.25rem, 0.5rem + 2vw, 2.5rem); margin-left: auto; }
  .nav a {
    position: relative; text-decoration: none; font-size: var(--t-sm); font-weight: 500; letter-spacing: 0.03em;
    color: var(--ink-3); padding-block: 0.5rem; transition: color 200ms ease;
  }
  /* A hairline that grows out from the centre. */
  .nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.15rem; height: 1.5px; border-radius: 1px;
    background: var(--accent); transform: scaleX(0); transition: transform 280ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover { color: var(--ink); }
    .nav a:hover::after { transform: scaleX(1); }
  }
  .nav a:focus-visible::after { transform: scaleX(1); }
  /* Current page: full-strength text and a line that stays. */
  .nav a[aria-current='page'] { color: var(--ink); font-weight: 600; }
  .nav a[aria-current='page']::after { transform: scaleX(1); }

  .tools { display: flex; align-items: center; gap: var(--s-2); }

  /* Language switch: one dark oak pill sits under the active language. On click it slides
     to the other side, then the page changes. */
  .lang {
    position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; padding: 3px; text-decoration: none;
    border: 1px solid var(--line); border-radius: 999px;
    font-size: clamp(0.66rem, 0.6rem + 0.2vw, 0.75rem); font-weight: 700; letter-spacing: 0.1em;
    transition: border-color 240ms ease;
  }
  .lang::before {
    content: ''; position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px);
    border-radius: 999px; background: var(--accent);
    transition: transform 320ms var(--ease-out);
  }
  .lang[data-on='en']::before { transform: translateX(100%); }
  .lang .opt {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    min-width: 2.1em; padding: 0.42em 0.7em; color: var(--ink-3);
    transition: color 220ms ease;
  }
  .lang[data-on='ka'] [data-opt='ka'], .lang[data-on='en'] [data-opt='en'] { color: var(--accent-ink); }
  @media (hover: hover) and (pointer: fine) {
    .lang:hover { border-color: color-mix(in oklab, var(--ink) 35%, transparent); }
    .lang[data-on='ka']:hover [data-opt='en'], .lang[data-on='en']:hover [data-opt='ka'] { color: var(--ink); }
  }

  /* Menu button: two lines that turn into an ✕. */
  .menu-btn {
    display: none; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center;
    background: none; border: 0; cursor: pointer; border-radius: 8px; transition: transform 160ms var(--ease-out);
  }
  .menu-btn:active { transform: scale(0.94); }
  .burger { position: relative; width: 22px; height: 12px; }
  .burger i {
    position: absolute; left: 0; width: 100%; height: 1.6px; border-radius: 2px; background: var(--ink);
    transition: transform 360ms var(--ease-in-out), top 360ms var(--ease-in-out);
  }
  .burger i:nth-child(1) { top: 0; }
  .burger i:nth-child(2) { top: calc(100% - 1.6px); }
  @media (hover: hover) and (pointer: fine) {
    .menu-btn[aria-expanded='false']:hover .burger i:nth-child(1) { transform: scaleX(0.6); transform-origin: right; }
    .menu-btn[aria-expanded='false']:hover .burger i:nth-child(2) { transform: scaleX(0.6); transform-origin: left; }
  }
  .menu-btn[aria-expanded='true'] .burger i:nth-child(1) { top: calc(50% - 0.8px); transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] .burger i:nth-child(2) { top: calc(50% - 0.8px); transform: rotate(-45deg); }

  /* ---------- Mobile menu ---------- */
  .menu { position: fixed; inset: var(--header-h) 0 0 0; z-index: 55; }
  .menu[hidden] { display: none; }
  .menu-slats { position: absolute; inset: 0; display: flex; }
  .menu-slats span {
    flex: 1 1 0; margin-right: -1px; background: var(--ground);
    box-shadow: inset -1px 0 0 color-mix(in oklab, var(--line) 55%, transparent);
    transform: scaleY(0); transform-origin: top;
    transition: transform 420ms var(--ease-out);
    transition-delay: calc(var(--i) * 35ms);
  }
  .menu.open .menu-slats span { transform: scaleY(1); }
  .menu.closing .menu-slats span { transition: transform 340ms var(--ease-in-out); transition-delay: calc((7 - var(--i)) * 30ms + 120ms); }

  .menu-nav { position: relative; display: flex; flex-direction: column; padding-top: clamp(1.5rem, 6vh, 3rem); }
  .menu-nav a {
    display: flex; align-items: baseline; gap: 1rem; padding-block: 0.9rem; text-decoration: none; color: var(--ink);
    border-bottom: 1px solid var(--line);
    opacity: 0; transform: translateY(14px);
    transition: opacity 360ms ease, transform 460ms var(--ease-out);
    transition-delay: calc(260ms + var(--j) * 60ms);
  }
  .menu.open .menu-nav a { opacity: 1; transform: none; }
  .menu.closing .menu-nav a { opacity: 0; transform: translateY(-6px); transition: opacity 160ms ease, transform 200ms ease; transition-delay: 0ms; }
  .mi-label { font-size: clamp(1.7rem, 1.2rem + 3vw, 2.4rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .mi-label { position: relative; transition: transform 360ms var(--ease-out); }
  .mi-arrow {
    margin-left: auto; align-self: center; font-size: 1.4rem; color: var(--ink-3);
    opacity: 0; transform: translateX(-10px); transition: opacity 260ms ease, transform 360ms var(--ease-out);
  }
  /* Active page in the menu: an accent bar slides in front of the label. */
  .menu-nav a[aria-current='page'] .mi-label { color: var(--accent); transform: translateX(1.1rem); }
  .menu-nav a[aria-current='page'] .mi-label::before {
    content: ''; position: absolute; left: -1.1rem; top: 50%; width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: var(--accent); transform: translateY(-50%);
  }
  .menu-nav a:active .mi-label { transform: translateX(0.5rem); }
  .menu-nav a[aria-current='page']:active .mi-label { transform: translateX(1.4rem); }
  .menu-nav a:active .mi-arrow, .menu-nav a:focus-visible .mi-arrow { opacity: 1; transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .menu-nav a:not(.menu-lang):hover .mi-label { transform: translateX(0.5rem); }
    .menu-nav a[aria-current='page']:hover .mi-label { transform: translateX(1.4rem); }
    .menu-nav a:hover .mi-arrow { opacity: 1; transform: none; }
  }
  .menu-nav .menu-lang { border: 0; margin-top: var(--s-2); font-size: var(--t-sm); font-weight: 600; color: var(--ink-2); letter-spacing: 0.06em; }

  @media (max-width: 860px) {
    .nav { display: none; }
    .tools { margin-left: auto; }
    .menu-btn { display: inline-flex; }
  }
  @media (min-width: 861px) { .menu { display: none !important; } }
  @media (prefers-reduced-motion: reduce) {
    .menu-slats span, .menu-nav a, .burger i { transition-duration: 1ms !important; transition-delay: 0ms !important; }
    .mi-label, .mi-arrow { transition-duration: 1ms !important; }
    .nav a::after, .lang::before { transition: none !important; }
  }
</style>

<script>
  // Remember where we are (which top-level block sits under the header, and how far into it),
  // so the other language opens at the same place. Matched by block, not pixels: the two
  // languages' text runs to different lengths. Restored in Base.astro before first paint.
  const saveSpot = (href: string) => {
    try {
      const to = new URL(href, location.href).pathname;
      if (scrollY < 4) { sessionStorage.removeItem('symmetry:spot'); return; }
      const y = (document.querySelector<HTMLElement>('[data-header]')?.offsetHeight ?? 0) + 1;
      const blocks = Array.from(document.querySelectorAll<HTMLElement>('main > *, body > footer'));
      let i = blocks.findIndex((b) => b.getBoundingClientRect().bottom > y);
      if (i < 0) i = blocks.length - 1;
      const r = blocks[i].getBoundingClientRect();
      const f = r.height ? Math.min(1, Math.max(0, (y - r.top) / r.height)) : 0;
      const end = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      sessionStorage.setItem('symmetry:spot', JSON.stringify({ to, i, f, end, t: Date.now() }));
    } catch {}
  };
  document.querySelectorAll<HTMLAnchorElement>('.menu-lang').forEach((a) =>
    a.addEventListener('click', (e) => { if (!(e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0)) saveSpot(a.href); }),
  );

  // Language switch: slide the pill across first, then go to the other language's page.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((sw) =>
    sw.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      saveSpot(sw.href);
      sw.dataset.on = sw.getAttribute('hreflang')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => { location.href = sw.href; }, reduce ? 0 : 300);
    }),
  );
  // Back button restoring this page from cache: put the pill back on this page's language.
  addEventListener('pageshow', (e) => {
    if (e.persisted) document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((sw) => (sw.dataset.on = document.documentElement.lang));
  });

  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 12);
  // First sync without the fade (see Base.astro); after that, scrolling fades the bar in and out.
  (window as any).__syncHeader?.();
  addEventListener('scroll', onScroll, { passive: true });

  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const lastSlat = menu.querySelector<HTMLElement>('.menu-slats span:first-child')!; // retracts last when closing
  let state: 'closed' | 'open' | 'closing' = 'closed';

  const lock = (on: boolean) => {
    document.documentElement.style.overflow = on ? 'hidden' : '';
    document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => (on ? el.setAttribute('inert', '') : el.removeAttribute('inert')));
  };

  const open = () => {
    if (state !== 'closed') return;
    state = 'open';
    menu.hidden = false;
    lock(true);
    header.setAttribute('data-menu-open', '');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', btn.dataset.closeLabel!);
    requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('open')));
    setTimeout(() => menu.querySelector<HTMLElement>('.menu-nav a')?.focus({ preventScroll: true }), 300);
  };

  /** Close, and resolve only once the slats have fully retracted. */
  const close = (): Promise<void> =>
    new Promise((resolve) => {
      if (state !== 'open') return resolve();
      state = 'closing';
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', btn.dataset.openLabel!);
      menu.classList.add('closing');
      menu.classList.remove('open');
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        menu.classList.remove('closing');
        menu.hidden = true;
        header.removeAttribute('data-menu-open');
        lock(false);
        state = 'closed';
        resolve();
      };
      lastSlat.addEventListener('transitionend', finish, { once: true });
      setTimeout(finish, 900); // safety net
    });

  btn.addEventListener('click', () => (state === 'open' ? close().then(() => btn.focus()) : open()));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && state === 'open') close().then(() => btn.focus());
    // Keep Tab inside the menu while it is open.
    if (e.key === 'Tab' && state === 'open') {
      const items = [btn, ...menu.querySelectorAll<HTMLElement>('a')];
      const i = items.indexOf(document.activeElement as HTMLElement);
      const next = e.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : (i + 1) % items.length;
      e.preventDefault();
      items[next].focus();
    }
  });

  // Navigate only after the closing animation has finished.
  menu.querySelectorAll<HTMLAnchorElement>('a').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      close().then(() => { location.href = a.href; });
    }),
  );
  // Leaving mobile width with the menu open: close it instantly.
  matchMedia('(min-width: 861px)').addEventListener('change', (m) => { if (m.matches && state === 'open') close(); });
</script>
