---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { type Lang, useT, path, altPath } from '../i18n/ui';

interface Props { lang: Lang; current: string }
const { lang, current } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'ka' ? 'en' : 'ka';
const links = [
  { key: 'products', href: path(lang, '/products/'), label: t('nav.products') },
  { key: 'about', href: path(lang, '/about/'), label: t('nav.about') },
  { key: 'contact', href: path(lang, '/contact/'), label: t('nav.contact') },
];
const switchHref = altPath(Astro.url.pathname, other);
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={path(lang, '/')} aria-label={`Symmetry, ${t('nav.home')}`}>
      <Wordmark />
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="tools">
      <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={t('lang.switch')}>
        <span class:list={['opt', { on: lang === 'ka' }]}>KA</span>
        <span class="sep" aria-hidden="true"></span>
        <span class:list={['opt', { on: lang === 'en' }]}>EN</span>
      </a>
      <button class="menu-btn" type="button" data-menu-open aria-label={t('nav.menu')} aria-haspopup="dialog">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <dialog class="sheet" data-menu aria-label={t('nav.menu')}>
    <div class="sheet-top wrap">
      <Wordmark />
      <button class="menu-btn" type="button" data-menu-close aria-label={t('nav.close')}>
        <Icon name="close" size={22} />
      </button>
    </div>
    <nav class="sheet-nav wrap" aria-label="Mobile">
      <a href={path(lang, '/')}>{t('nav.home')}</a>
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="sheet-lang" href={switchHref} hreflang={other} lang={other}>{t('lang.switch')}</a>
    </nav>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    transition: background-color 400ms ease, border-color 400ms ease;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    background: color-mix(in oklab, var(--ground) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-color: color-mix(in oklab, var(--line) 70%, transparent);
  }
  .bar { display: flex; align-items: center; gap: var(--s-4); height: 4.75rem; }
  .brand { text-decoration: none; display: inline-flex; }
  .nav { display: flex; gap: var(--s-4); margin-left: auto; }
  .nav a {
    position: relative; text-decoration: none; font-size: var(--t-sm); font-weight: 500; letter-spacing: 0.03em;
    color: var(--ink-2); padding-block: 0.5rem; transition: color 200ms ease;
  }
  .nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.2rem; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left; transition: transform 380ms var(--ease-out);
  }
  .nav a[aria-current='page'] { color: var(--ink); }
  .nav a[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover { color: var(--ink); }
    .nav a:hover::after { transform: scaleX(1); }
  }
  .tools { display: flex; align-items: center; gap: var(--s-2); }
  .lang {
    display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none;
    font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.14em; padding: 0.6rem 0;
  }
  .lang .opt { color: var(--ink-3); transition: color 200ms ease; }
  .lang .opt.on { color: var(--ink); }
  .lang .sep { width: 1px; height: 0.9rem; background: var(--line); }
  @media (hover: hover) and (pointer: fine) { .lang:hover .opt { color: var(--ink); } }
  .menu-btn {
    display: none; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center;
    background: none; border: 0; cursor: pointer; border-radius: var(--radius);
    transition: transform 160ms var(--ease-out);
  }
  .menu-btn:active { transform: scale(0.94); }

  .sheet {
    position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none;
    border: 0; padding: 0; background: var(--ground); color: var(--ink);
    opacity: 1; transform: none;
    transition: opacity 300ms var(--ease-out), transform 420ms var(--ease-drawer), overlay 300ms allow-discrete, display 300ms allow-discrete;
  }
  .sheet:not([open]) { opacity: 0; transform: translateY(-2%); }
  @starting-style { .sheet[open] { opacity: 0; transform: translateY(-2%); } }
  .sheet::backdrop { background: transparent; }
  .sheet-top { display: flex; align-items: center; justify-content: space-between; height: 4.75rem; }
  .sheet-nav { display: flex; flex-direction: column; gap: 0.25rem; padding-top: var(--s-5); }
  .sheet-nav a {
    font-family: var(--f-display); font-size: var(--t-3xl); line-height: 1.25; text-decoration: none;
    border-bottom: 1px solid var(--line); padding-block: 0.6rem;
  }
  .sheet-nav a[aria-current='page'] { font-style: italic; }
  .sheet-nav .sheet-lang { font-family: var(--f-text); font-size: var(--t-sm); letter-spacing: 0.14em; border: 0; margin-top: var(--s-3); color: var(--ink-2); }

  @media (max-width: 860px) {
    .nav { display: none; }
    .tools { margin-left: auto; }
    .menu-btn { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet { transition: opacity 200ms ease, overlay 200ms allow-discrete, display 200ms allow-discrete; transform: none !important; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 12);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const sheet = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => sheet.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => sheet.close());
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => sheet.close()));
</script>
