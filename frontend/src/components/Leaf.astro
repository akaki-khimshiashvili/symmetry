---
import { relief, seedFrom } from '../lib/relief';
import { responsive, type Responsive } from '../lib/img';
import type { Product } from '../lib/data';

interface Props {
  product: Product;
  alt: string;
  ratio?: number;       // width / height of the frame
  mirror?: boolean;
  eager?: boolean;
  density?: number;
  photo?: boolean;      // allow a real photo when one exists
  sizes?: string;       // displayed width, so the browser picks the right resized copy
  widths?: number[];    // resized copies to make (card sizes by default)
  pic?: Responsive;     // already resized by the caller (the product page sizes each photo by its shape)
  defer?: boolean;      // drawn relief: insert it only when it nears the viewport (cards in vertical grids)
  class?: string;
}
const { product, alt, ratio = 0.8, mirror = false, eager = false, density = 1, photo = true, defer = false, sizes = '(max-width: 960px) 50vw, 400px', widths = [240, 400, 640, 960, 1280], pic: given, class: cls = '' } = Astro.props;
const img = photo ? product.images[0] : undefined;
// Photos are resized at build time into a few widths; the browser fetches the one that fits.
const pic = img ? given ?? (await responsive(img.url, widths, sizes)) : undefined;
const W = 1000;
const H = Math.round(W / Math.max(0.3, Math.min(3, ratio)));
// A relief is a few hundred SVG nodes. Off-screen cards keep it in a <template> (inert, not part of the
// page DOM) and the script below puts it in place just before the card scrolls into view.
const lazySvg = !img && defer && !eager;
const svg = img
  ? ''
  : relief({ pattern: product.pattern, width: W, height: H, mirror, density, seed: seedFrom(product.slug), uid: `${product.slug}${mirror ? 'm' : ''}${Math.round(ratio * 100)}`, label: lazySvg ? undefined : alt });
---
<div class:list={['leaf', cls]} style={`aspect-ratio:${ratio}`} {...(lazySvg ? { 'data-relief': '', ...(alt ? { role: 'img', 'aria-label': alt } : {}) } : {})}>
  {pic ? (
    <img src={pic.src} srcset={pic.srcset} sizes={pic.sizes} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" style={mirror ? 'transform:scaleX(-1)' : undefined} />
  ) : (
    lazySvg ? <template set:html={svg} /> : <Fragment set:html={svg} />
  )}
</div>

<style>
  .leaf { position: relative; overflow: hidden; background: var(--gap); width: 100%; }
  .leaf :global(svg), .leaf img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const t = e.target.querySelector(":scope > template") as HTMLTemplateElement | null;
        if (t) t.replaceWith(t.content);
        io.unobserve(e.target);
      }
    },
    { rootMargin: "300px 0px" },
  );
  const watch = () => document.querySelectorAll("[data-relief]").forEach((el) => io.observe(el));
  watch();
  document.addEventListener("symmetry:content", watch);
</script>
