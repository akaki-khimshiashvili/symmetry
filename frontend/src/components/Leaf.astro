---
import { relief, seedFrom } from '../lib/relief';
import type { Product } from '../lib/data';

interface Props {
  product: Product;
  alt: string;
  ratio?: number;       // width / height of the frame
  mirror?: boolean;
  eager?: boolean;
  density?: number;
  photo?: boolean;      // allow a real photo when one exists
  class?: string;
}
const { product, alt, ratio = 0.8, mirror = false, eager = false, density = 1, photo = true, class: cls = '' } = Astro.props;
const img = photo ? product.images[0] : undefined;
const W = 1000;
const H = Math.round(W / Math.max(0.3, Math.min(3, ratio)));
const svg = img
  ? ''
  : relief({ pattern: product.pattern, width: W, height: H, mirror, density, seed: seedFrom(product.slug), uid: `${product.slug}${mirror ? 'm' : ''}${Math.round(ratio * 100)}`, label: alt });
---
<div class:list={['leaf', cls]} style={`aspect-ratio:${ratio}`}>
  {img ? (
    <img src={img.url} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" style={mirror ? 'transform:scaleX(-1)' : undefined} />
  ) : (
    <Fragment set:html={svg} />
  )}
</div>

<style>
  .leaf { position: relative; overflow: hidden; background: var(--gap); width: 100%; }
  .leaf :global(svg), .leaf img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>
