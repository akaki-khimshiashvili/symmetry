---
import Icon from './Icon.astro';
import { type Lang, useT, CLIENT_TYPES } from '../i18n/ui';
import { API_URL, loadData } from '../lib/data';

interface Props { lang: Lang; kind: 'contact' | 'order'; id?: string }
const { lang, kind, id = `${kind}-form` } = Astro.props;
const t = useT(lang);
const { settings } = await loadData();
// Orders go straight to Flitt's checkout when online payment is on.
const pays = kind === 'order' && !!settings.payments;
const submitLabel = pays ? t('order.pay') : kind === 'order' ? t('order.submit') : t('f.submit');
const msgs = {
  required: t('f.error.required'),
  phone: t('f.error.phone'),
  email: t('f.error.email'),
  network: t('f.error.network'),
  generic: t('f.error.generic'),
  sending: t('f.sending'),
  redirecting: t('order.redirecting'),
  outOfStock: t('f.error.outOfStock'),
};
const endpoint = `${API_URL}/${kind === 'order' ? 'orders' : 'contact'}`;
const f = (k: string) => `${id}-${k}`;
// Orders always need an email: the receipt and every status update are sent there.
const emailAlways = kind === 'order';
const channels = [
  { key: 'whatsapp', icon: 'whatsapp' },
  { key: 'email', icon: 'mail' },
  { key: 'phone', icon: 'phone' },
] as const;
const intents = [
  { key: 'order', icon: 'bag' },
  { key: 'question', icon: 'question' },
  { key: 'other', icon: 'dots' },
] as const;
---
<form class="lead" id={id} data-lead-form data-email-always={emailAlways ? '' : undefined} data-endpoint={endpoint} data-msgs={JSON.stringify(msgs)} novalidate>
  <input type="hidden" name="lang" value={lang} />
  {kind === 'order' && (<><input type="hidden" name="product_id" /><input type="hidden" name="size_id" /></>)}
  <div class="hp" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="fields">
    <div class="field">
      <label for={f('first')}>{t('f.firstName')} <span class="req" aria-hidden="true">*</span></label>
      <div class="control">
        <Icon name="user" size={18} class="ci" />
        <input id={f('first')} name="first_name" autocomplete="given-name" required />
      </div>
      <p class="err" data-err="first_name"></p>
    </div>

    <div class="field">
      <label for={f('phone')}>{t('f.phone')} <span class="req" aria-hidden="true">*</span></label>
      <div class="control">
        <Icon name="phone" size={18} class="ci" />
        <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+995 5XX XX XX XX" required />
      </div>
      <p class="err" data-err="phone"></p>
    </div>

    <div class="field full">
      <label for={f('type')} id={f('type-label')}>{t('f.clientType')} <span class="req" aria-hidden="true">*</span></label>
      <div class="control dd" data-dd>
        <Icon name="briefcase" size={18} class="ci" />
        <button type="button" class="dd-btn" id={f('type')} data-name="client_type" data-empty
          aria-haspopup="listbox" aria-expanded="false" aria-controls={f('type-list')} aria-labelledby={`${f('type-label')} ${f('type')}`}>
          <span data-dd-value>{t('f.select')}</span>
        </button>
        <Icon name="chevron" size={18} class="chev" />
        <input type="hidden" name="client_type" value="" />
        <ul class="dd-list" id={f('type-list')} role="listbox" aria-labelledby={f('type-label')}>
          {CLIENT_TYPES.map((c) => (
            <li role="option" id={f(`type-${c}`)} data-value={c} aria-selected="false">
              <span>{t(`ct.${c}` as any)}</span>
              <Icon name="check" size={16} class="dd-check" />
            </li>
          ))}
        </ul>
      </div>
      <p class="err" data-err="client_type"></p>
    </div>

    <fieldset class="field full">
      <legend>{t('f.channel')} <span class="req" aria-hidden="true">*</span></legend>
      <div class="seg">
        {channels.map((c, i) => (
          <label class="seg-opt">
            <input type="radio" name="channel" value={c.key} checked={i === 0} required />
            <Icon name={c.icon} size={18} />
            <span>{t(`ch.${c.key}`)}</span>
          </label>
        ))}
      </div>
      <p class="err" data-err="channel"></p>
    </fieldset>

    <div class="field full">
      <label for={f('email')}>
        {t('f.email')}<span class="req gap" aria-hidden="true" data-email-req hidden={!emailAlways}>*</span><span class="opt gap" data-email-opt hidden={emailAlways}>({t('f.optional')})</span>
      </label>
      <div class="control">
        <Icon name="mail" size={18} class="ci" />
        <input id={f('email')} name="email" type="email" autocomplete="email" placeholder="name@example.com" aria-describedby={f('email-hint')} required={emailAlways} />
      </div>
      <p class="hint" id={f('email-hint')}>{emailAlways ? t('order.emailHint') : t('f.emailHint')}</p>
      <p class="err" data-err="email"></p>
    </div>

    {kind === 'contact' && (
      <fieldset class="field full">
        <legend>{t('f.intent')} <span class="req" aria-hidden="true">*</span></legend>
        <div class="seg">
          {intents.map((c) => (
            <label class="seg-opt">
              <input type="radio" name="intent" value={c.key} required />
              <Icon name={c.icon} size={18} />
              <span>{t(`f.intent.${c.key}`)}</span>
            </label>
          ))}
        </div>
        <p class="err" data-err="intent"></p>
      </fieldset>
    )}

    <div class="field full">
      <label for={f('msg')}>{t('f.message')}<span class="opt gap">({t('f.optional')})</span></label>
      <div class="control area">
        <Icon name="message" size={18} class="ci" />
        <textarea id={f('msg')} name="message" rows="4" maxlength="4000"></textarea>
      </div>
    </div>
  </div>

  <p class="form-err" role="alert" data-form-err hidden><Icon name="alert" size={18} /><span></span></p>

  <button class="btn btn-solid submit" type="submit" data-label={submitLabel}>
    <span>{submitLabel}</span>
    <Icon name="arrow" size={18} />
  </button>
  {pays && <p class="pay-note">{t('order.payNote')}</p>}

  <div class="done" data-done hidden tabindex="-1" role="status">
    <span class="done-mark" aria-hidden="true">
      <svg viewBox="0 0 52 52" width="52" height="52"><path class="done-tick" d="M15 27.5 22.5 35 37.5 18" /></svg>
    </span>
    <p class="done-t">{kind === 'order' ? t('order.success.t') : t('f.success.t')}</p>
    <p class="done-d">{kind === 'order' ? t('order.success.d') : t('f.success.d')}</p>
    {kind === 'contact' && (
      <button type="button" class="btn btn-line done-again" data-again>{t('f.again')}</button>
    )}
  </div>
</form>

<style>
  .lead {
    --field-bg: color-mix(in oklab, var(--ground) 55%, white);
    --field-line: color-mix(in oklab, var(--ink) 13%, transparent);
    --field-line-hover: color-mix(in oklab, var(--ink) 26%, transparent);
    --danger: oklch(0.55 0.16 30);
    position: relative; display: grid; gap: var(--s-3);
  }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .req { color: var(--accent); font-weight: 600; }
  .gap { margin-inline-start: 0.35em; }
  .req[hidden], .opt[hidden] { display: none; }
  .opt { font-weight: 400; color: var(--ink-3); }

  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 1rem; }
  .pay-note { margin: -0.4rem 0 0; font-size: var(--t-sm); color: var(--ink-2); text-wrap: pretty; }
  .field { display: grid; gap: 0.45rem; min-width: 0; margin: 0; padding: 0; border: 0; }
  .full { grid-column: 1 / -1; }
  label, legend { display: block; padding: 0; font-size: var(--t-sm); font-weight: 500; color: var(--ink-2); }
  legend { margin-bottom: 0.45rem; }

  /* ---------- Inputs ---------- */
  .control {
    position: relative; display: flex; align-items: center;
    background: var(--field-bg); border: 1px solid var(--field-line); border-radius: 10px;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .control :global(.ci) { position: absolute; left: 0.9rem; color: var(--ink-3); pointer-events: none; transition: color 150ms ease; }
  .control :global(.chev) { position: absolute; right: 0.85rem; color: var(--ink-3); pointer-events: none; }
  .control input, .control select, .control textarea {
    width: 100%; min-width: 0; height: 3rem; padding: 0 1rem 0 2.75rem;
    background: transparent; border: 0; border-radius: inherit; outline: none;
    font: inherit; font-size: var(--t-base); color: var(--ink);
  }

  /* ---------- Custom dropdown (client type) ---------- */
  .dd-btn {
    width: 100%; min-width: 0; height: 3rem; padding: 0 2.6rem 0 2.75rem;
    background: transparent; border: 0; border-radius: inherit; outline: none; cursor: pointer;
    font: inherit; font-size: var(--t-base); color: var(--ink); text-align: left;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .dd-btn[data-empty] { color: color-mix(in oklab, var(--ink-3) 85%, transparent); }
  .dd :global(.chev) { transition: transform 200ms var(--ease-out); }
  .dd[data-open] :global(.chev) { transform: rotate(180deg); }
  .dd-list {
    position: absolute; z-index: 20; top: calc(100% + 6px); left: 0; right: 0;
    margin: 0; padding: 0.35rem; list-style: none; max-height: 17rem; overflow-y: auto; overscroll-behavior: contain;
    background: var(--ground); border: 1px solid var(--field-line); border-radius: 12px;
    box-shadow: 0 2px 6px rgb(40 22 10 / 0.08), 0 18px 40px -12px rgb(40 22 10 / 0.28);
    opacity: 0; visibility: hidden; transform: translateY(-6px) scale(0.98); transform-origin: top center;
    transition: opacity 160ms ease, transform 200ms var(--ease-out), visibility 0s linear 200ms;
  }
  .dd[data-open] .dd-list { opacity: 1; visibility: visible; transform: none; transition: opacity 160ms ease, transform 200ms var(--ease-out), visibility 0s; }
  .dd-list li {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.7rem 0.8rem; border-radius: 8px; cursor: pointer;
    font-size: var(--t-sm); color: var(--ink-2); transition: background-color 120ms ease, color 120ms ease;
  }
  .dd-list li[data-active] { background: var(--ground-2); color: var(--ink); }
  .dd-list li[aria-selected='true'] { color: var(--ink); font-weight: 600; }
  .dd-list :global(.dd-check) { flex: none; color: var(--accent); opacity: 0; transform: scale(0.6); transition: opacity 150ms ease, transform 200ms var(--ease-out); }
  .dd-list li[aria-selected='true'] :global(.dd-check) { opacity: 1; transform: none; }
  .control.area { align-items: flex-start; }
  .control.area :global(.ci) { top: 0.85rem; }
  .control textarea { height: auto; min-height: 7.5rem; padding-block: 0.75rem; line-height: 1.55; resize: vertical; }
  /* A slim oak scrollbar inside the field instead of the page's track. */
  .control textarea, .dd-list { scrollbar-width: thin; scrollbar-color: color-mix(in oklab, var(--wood-lo) 35%, transparent) transparent; }
  .control textarea::-webkit-scrollbar, .dd-list::-webkit-scrollbar { width: 10px; }
  .control textarea::-webkit-scrollbar-track, .dd-list::-webkit-scrollbar-track { background: transparent; margin-block: 8px; }
  .control textarea::-webkit-scrollbar-thumb, .dd-list::-webkit-scrollbar-thumb {
    background: color-mix(in oklab, var(--wood-lo) 30%, transparent); border-radius: 10px;
    border: 3px solid transparent; background-clip: padding-box;
  }
  .control textarea::-webkit-scrollbar-thumb:hover, .dd-list::-webkit-scrollbar-thumb:hover { background-color: color-mix(in oklab, var(--wood-lo) 55%, transparent); }
  .control ::placeholder { color: var(--ink-3); opacity: 0.7; }

  @media (hover: hover) and (pointer: fine) {
    .control:hover { border-color: var(--field-line-hover); }
  }
  .control:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 12%, transparent);
  }
  .control:focus-within :global(.ci) { color: var(--ink); }

  /* ---------- Segmented choices (channel, intent) ---------- */
  .seg { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .seg-opt {
    position: relative; flex: 1 1 auto; min-width: 7.5rem; white-space: nowrap;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
    height: 3rem; padding: 0 1rem; border-radius: 10px; cursor: pointer;
    background: var(--field-bg); border: 1px solid var(--field-line); color: var(--ink-2);
    font-size: var(--t-sm); font-weight: 500;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease, transform 160ms var(--ease-out);
  }
  .seg-opt input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; appearance: none; background: none; border: 0; }
  .seg-opt :global(.icon), .submit :global(.icon) { flex: none; }
  /* Centre the letters themselves, not the line box: trim to the x-height (Georgian, lowercase)
     or cap height (Latin) so the label sits optically level with its icon. */
  .seg-opt span, .submit span { line-height: 1.2; text-box: trim-both cap alphabetic; }
  :lang(ka) .seg-opt span, :lang(ka) .submit span { text-box: trim-both ex alphabetic; }
  @media (hover: hover) and (pointer: fine) {
    .seg-opt:hover { border-color: var(--field-line-hover); color: var(--ink); }
  }
  .seg-opt:active { transform: scale(0.97); }
  .seg-opt:has(input:checked) { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .seg-opt:has(input:focus-visible) { outline: 1.5px solid var(--accent); outline-offset: 2px; }

  /* ---------- Messages ---------- */
  .hint { margin: 0; font-size: var(--t-xs); color: var(--ink-3); }
  .err { margin: 0; font-size: var(--t-xs); font-weight: 500; color: var(--danger); }
  .err:empty { display: none; }
  .field:has([aria-invalid='true']) .control { border-color: var(--danger); }
  .field:has([aria-invalid='true']) .control:focus-within { box-shadow: 0 0 0 3px color-mix(in oklab, var(--danger) 12%, transparent); }
  .field:has([aria-invalid='true']) :global(.ci) { color: var(--danger); }
  .field:has([aria-invalid='true']) .seg-opt:not(:has(input:checked)) { border-color: color-mix(in oklab, var(--danger) 60%, transparent); }

  .form-err {
    display: flex; gap: 0.6rem; align-items: flex-start; margin: 0; padding: 0.85rem 1rem;
    border-radius: 10px; font-size: var(--t-sm); color: var(--ink);
    background: color-mix(in oklab, var(--danger) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--danger) 35%, transparent);
  }
  .form-err :global(.icon) { color: var(--danger); flex: none; margin-top: 1px; }
  .form-err[hidden] { display: none; }

  /* ---------- Submit ---------- */
  .submit { justify-self: start; min-width: 12rem; gap: 0.6rem; }
  .submit:active { transform: scale(0.97); }

  /* ---------- Sent ----------
     The form steps aside (kept in place, so the card keeps its height) and a centred confirmation
     takes its spot: a ring that blooms, a tick that draws itself, then the words rise in. */
  .lead:has(.done:not([hidden])) > :not(.done) { visibility: hidden; }
  .done {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 1rem; text-align: center; outline: none;
  }
  .done[hidden] { display: none; }
  .done-mark {
    position: relative; display: grid; place-items: center; width: 5.5rem; height: 5.5rem; margin-bottom: 1.5rem;
    border-radius: 50%; background: var(--accent); color: var(--accent-ink);
    box-shadow: 0 0 0 10px color-mix(in oklab, var(--accent) 9%, transparent), 0 18px 34px -14px rgb(40 22 10 / 0.5);
    animation: done-bloom 600ms var(--ease-out) both;
  }
  .done-mark::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    border: 1.5px solid color-mix(in oklab, var(--accent) 45%, transparent);
    animation: done-ring 1100ms var(--ease-out) 250ms both;
  }
  .done-mark svg { width: 2.6rem; height: 2.6rem; overflow: visible; }
  .done-tick {
    fill: none; stroke: currentColor; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 36; stroke-dashoffset: 36; animation: done-draw 420ms var(--ease-out) 330ms forwards;
  }
  .done-t {
    margin: 0; max-width: 20ch; font-family: var(--f-display); font-size: var(--t-xl); line-height: 1.2; text-wrap: balance;
    animation: done-rise 600ms var(--ease-out) 420ms both;
  }
  .done-d { margin: 0.6rem 0 0; max-width: 32ch; color: var(--ink-2); text-wrap: pretty; animation: done-rise 600ms var(--ease-out) 500ms both; }
  .done-again { margin-top: 1.75rem; animation: done-rise 600ms var(--ease-out) 600ms both; }
  .done-again:active { transform: scale(0.97); }
  @keyframes done-bloom { from { opacity: 0; transform: scale(0.6); } 60% { opacity: 1; transform: scale(1.06); } to { transform: none; } }
  @keyframes done-ring { from { opacity: 0.9; transform: scale(1); } to { opacity: 0; transform: scale(1.7); } }
  @keyframes done-draw { to { stroke-dashoffset: 0; } }
  @keyframes done-rise { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 620px) {
    .fields { grid-template-columns: 1fr; }
    .submit { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .done-mark, .done-mark::after, .done-t, .done-d, .done-again { animation: none; }
    .done-mark::after { display: none; }
    .done-tick { animation: none; stroke-dashoffset: 0; }
    .dd-list, .dd[data-open] .dd-list { transform: none; }
  }
</style>

<script>
  type Msgs = Record<string, string>;
  const PHONE = /^\+?\d{7,15}$/;
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const msgs: Msgs = JSON.parse(form.dataset.msgs || '{}');
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const btnLabel = btn.querySelector('span')!;
    const formErr = form.querySelector<HTMLElement>('[data-form-err]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const emailOpt = form.querySelector<HTMLElement>('[data-email-opt]');
    const emailReq = form.querySelector<HTMLElement>('[data-email-req]');
    const emailInput = form.querySelector<HTMLInputElement>('[name="email"]');

    const val = (name: string) => ((form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null)?.value ?? '').trim();

    const setErr = (name: string, m: string) => {
      const el = form.querySelector<HTMLElement>(`[data-err="${name}"]`);
      if (el) el.textContent = m;
      form.querySelectorAll<HTMLElement>(`[name="${name}"], [data-name="${name}"]`).forEach((i) => {
        if (m) i.setAttribute('aria-invalid', 'true');
        else i.removeAttribute('aria-invalid');
      });
    };

    // Email becomes required when the visitor picks "Email" as the reply channel.
    const syncChannel = () => {
      const isEmail = val('channel') === 'email' || form.hasAttribute('data-email-always');
      if (emailOpt) emailOpt.hidden = isEmail;
      if (emailReq) emailReq.hidden = !isEmail;
      if (emailInput) emailInput.required = isEmail;
    };

    form.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name && target.getAttribute('aria-invalid')) setErr(target.name, '');
    });
    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name === 'channel') { syncChannel(); setErr('email', ''); }
      if (target.name) setErr(target.name, '');
    });
    // Format problems are pointed out when the visitor leaves the field, not while typing.
    form.addEventListener('focusout', (e) => {
      const n = (e.target as HTMLInputElement).name;
      const v = val(n);
      if (n === 'phone' && v && !PHONE.test(v.replace(/[\s\-()]/g, ''))) setErr(n, msgs.phone);
      if (n === 'email' && v && !EMAIL.test(v)) setErr(n, msgs.email);
    });
    syncChannel();

    // Custom dropdowns: a button + listbox writing into a hidden input (focus stays on the button;
    // the highlighted option is announced through aria-activedescendant).
    form.querySelectorAll<HTMLElement>('[data-dd]').forEach((dd) => {
      const btn = dd.querySelector<HTMLButtonElement>('.dd-btn')!;
      const input = dd.querySelector<HTMLInputElement>('input[type=hidden]')!;
      const label = dd.querySelector<HTMLElement>('[data-dd-value]')!;
      const opts = Array.from(dd.querySelectorAll<HTMLElement>('[role=option]'));
      let active = -1;
      const isOpen = () => dd.hasAttribute('data-open');
      const selected = () => opts.findIndex((o) => o.getAttribute('aria-selected') === 'true');
      const setActive = (i: number) => {
        active = i;
        opts.forEach((o, j) => o.toggleAttribute('data-active', j === i));
        if (i >= 0) { btn.setAttribute('aria-activedescendant', opts[i].id); opts[i].scrollIntoView({ block: 'nearest' }); }
        else btn.removeAttribute('aria-activedescendant');
      };
      const open = () => { dd.setAttribute('data-open', ''); btn.setAttribute('aria-expanded', 'true'); setActive(Math.max(0, selected())); };
      const close = () => { dd.removeAttribute('data-open'); btn.setAttribute('aria-expanded', 'false'); setActive(-1); };
      const placeholder = label.textContent;
      // "Send another message": back to the empty choice.
      form.addEventListener('reset', () => {
        opts.forEach((o) => o.setAttribute('aria-selected', 'false'));
        input.value = '';
        label.textContent = placeholder;
        btn.setAttribute('data-empty', '');
        close();
      });
      const choose = (i: number) => {
        opts.forEach((o, j) => o.setAttribute('aria-selected', String(j === i)));
        input.value = opts[i].dataset.value || '';
        label.textContent = opts[i].textContent!.trim();
        btn.removeAttribute('data-empty');
        input.dispatchEvent(new Event('change', { bubbles: true }));
        close();
        btn.focus();
      };
      btn.addEventListener('click', () => (isOpen() ? close() : open()));
      btn.addEventListener('keydown', (e) => {
        const n = opts.length;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (!isOpen()) return open();
          setActive((active + (e.key === 'ArrowDown' ? 1 : -1) + n) % n);
        } else if (e.key === 'Home' || e.key === 'End') {
          if (!isOpen()) return;
          e.preventDefault();
          setActive(e.key === 'Home' ? 0 : n - 1);
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (isOpen() && active >= 0) choose(active); else open();
        } else if (e.key === 'Escape') {
          if (isOpen()) { e.preventDefault(); close(); }
        } else if (e.key === 'Tab') {
          close();
        } else if (e.key.length === 1 && /\S/.test(e.key)) {
          // Type-ahead: jump to the next option starting with that letter.
          const k = e.key.toLocaleLowerCase();
          const start = active < 0 ? 0 : active + 1;
          for (let j = 0; j < n; j++) {
            const o = opts[(start + j) % n];
            if (o.textContent!.trim().toLocaleLowerCase().startsWith(k)) { if (!isOpen()) open(); setActive((start + j) % n); break; }
          }
        }
      });
      opts.forEach((o, i) => {
        o.addEventListener('mousedown', (e) => e.preventDefault()); // keep focus on the button
        o.addEventListener('click', () => choose(i));
        o.addEventListener('pointermove', () => { if (active !== i) setActive(i); });
      });
      document.addEventListener('pointerdown', (e) => { if (isOpen() && !dd.contains(e.target as Node)) close(); });
    });

    const validate = (data: Record<string, string>) => {
      const errs: Record<string, string> = {};
      for (const k of ['first_name', 'phone', 'client_type', 'channel']) {
        if (!data[k]?.trim()) errs[k] = msgs.required;
      }
      if (form.querySelector('[name="intent"]') && !data.intent) errs.intent = msgs.required;
      const phone = (data.phone || '').replace(/[\s\-()]/g, '');
      if (phone && !PHONE.test(phone)) errs.phone = msgs.phone;
      if ((data.channel === 'email' || form.hasAttribute('data-email-always')) && !data.email?.trim()) errs.email = msgs.required;
      else if (data.email && !EMAIL.test(data.email.trim())) errs.email = msgs.email;
      return errs;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formErr.hidden = true;
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      ['first_name', 'phone', 'client_type', 'channel', 'email', 'intent'].forEach((k) => setErr(k, ''));
      const errs = validate(data);
      if (Object.keys(errs).length) {
        Object.entries(errs).forEach(([k, v]) => setErr(k, v));
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      btn.disabled = true;
      btnLabel.textContent = msgs.sending;
      let leaving = false;
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.status === 422) {
          const body = await res.json().catch(() => ({}));
          if (body.fields?.product_id === 'out_of_stock') {
            form.dispatchEvent(new CustomEvent('lead:out-of-stock', { bubbles: true }));
            throw new Error(msgs.outOfStock);
          }
          Object.entries(body.fields || {}).forEach(([k, v]) =>
            setErr(k, v === 'invalid' ? (k === 'email' ? msgs.email : k === 'phone' ? msgs.phone : msgs.required) : msgs.required),
          );
          throw new Error(msgs.generic);
        }
        if (!res.ok) throw new Error(msgs.network);
        const body = await res.json().catch(() => ({}));
        // Online payment: hand the customer to Flitt's hosted checkout.
        if (typeof body.checkout_url === 'string' && body.checkout_url.startsWith('https://')) {
          leaving = true;
          btnLabel.textContent = msgs.redirecting;
          location.assign(body.checkout_url);
          return;
        }
        done.hidden = false;
        done.focus();
        formErr.hidden = true;
        form.dispatchEvent(new CustomEvent('lead:sent', { bubbles: true }));
      } catch (err) {
        const m = err instanceof Error && (err.message === msgs.generic || err.message === msgs.outOfStock) ? err.message : msgs.network;
        formErr.querySelector('span')!.textContent = m;
        formErr.hidden = false;
      } finally {
        if (!leaving) {
          btn.disabled = false;
          btnLabel.textContent = btn.dataset.label || '';
        }
      }
    });

    // "Send another message": clear the form and bring it back.
    done.querySelector<HTMLButtonElement>('[data-again]')?.addEventListener('click', () => {
      form.reset();
      syncChannel();
      done.hidden = true;
      form.querySelector<HTMLElement>('input:not([type=hidden]):not(.hp input)')?.focus();
    });
  });
</script>
