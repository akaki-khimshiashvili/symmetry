---
import Icon from './Icon.astro';
import { type Lang, useT, path } from '../i18n/ui';
import { loadData, homeText } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const { settings } = await loadData();
// Title and lead can be changed in the admin (მთავარი გვერდი); otherwise the built-in wording.
const title = homeText(settings, 'hero_title', lang) || t('hero.title');
const lead = homeText(settings, 'hero_lead', lang) || t('hero.lead');
const socials = [
  { key: 'instagram', href: settings.instagram, label: 'Instagram' },
  { key: 'facebook', href: settings.facebook, label: 'Facebook' },
  { key: 'tiktok', href: settings.tiktok, label: 'TikTok' },
].filter((x) => x.href);

/* Static fallback (no WebGL / before the 3D scene is ready): the same wall, drawn flat. */
const VW = 1200, VH = 520;
const N = 28, W = 26, G = 13, H = 380, TOP = 64;
const X0 = (VW - (N * W + (N - 1) * G)) / 2;
const slats = Array.from({ length: N }, (_, i) => {
  const d = 12 + 50 * (0.5 + 0.5 * Math.sin(i * 0.36));
  const x = X0 + i * (W + G);
  const dx = d * 0.26, dy = d * 0.14;
  return {
    x,
    side: `${x + W},${TOP} ${x + W + dx},${TOP - dy} ${x + W + dx},${TOP + H - dy} ${x + W},${TOP + H}`,
    top: `${x},${TOP} ${x + dx},${TOP - dy} ${x + W + dx},${TOP - dy} ${x + W},${TOP}`,
    sx: x + d * 1.1,
    sy: TOP + d * 0.3,
  };
});
---
<section class="hero" data-hero>
  <div class="wrap center-stack hero-copy">
    <h1 class="h-title">{title.split(' ').map((w, i) => <><span class="w" style={`--w:${i}`}>{w}</span>{' '}</>)}</h1>
    <p class="lead h-lead">{lead}</p>
    <div class="h-actions">
      <a class="btn btn-solid btn-lg" href={path(lang, '/products/')}>{t('hero.cta.products')}</a>
      <a class="btn btn-line btn-lg" href={path(lang, '/contact/')}>{t('hero.cta.contact')}</a>
    </div>
    {socials.length > 0 && (
      <ul class="h-social" aria-label={t('contact.social')}>
        {socials.map((x) => (
          <li>
            <a href={x.href} target="_blank" rel="noopener" aria-label={x.label} title={x.label}>
              <Icon name={x.key} size={18} />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <figure class="scene" aria-hidden="true" data-scene>
    <svg class="fallback" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="slatFront" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="f0" />
          <stop offset="1" class="f1" />
        </linearGradient>
        <filter id="soft" x="-30%" y="-20%" width="160%" height="140%"><feGaussianBlur stdDeviation="9" /></filter>
      </defs>
      <g filter="url(#soft)">{slats.map((s) => <rect class="sh" x={s.sx} y={s.sy} width={W} height={H} />)}</g>
      {slats.map((s) => (
        <g>
          <polygon class="side" points={s.side} />
          <polygon class="top" points={s.top} />
          <rect class="front" x={s.x} y={TOP} width={W} height={H} />
        </g>
      ))}
    </svg>
  </figure>
</section>

<style>
  .hero { position: relative; padding-top: clamp(1.5rem, 5vh, 3.5rem); overflow: clip; }
  .hero-copy { position: relative; z-index: 1; }
  .h-title { font-size: clamp(2.5rem, 1rem + 4vw, 4.6rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.035em; text-wrap: balance; max-width: 18ch; }
  :lang(ka) .h-title { font-size: clamp(2.2rem, 0.9rem + 3.4vw, 4rem); line-height: 1.14; letter-spacing: -0.02em; max-width: 20ch; }
  .hero-copy { gap: 1.1rem; }
  .h-lead { font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem); max-width: 44rem !important; }
  .h-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; }
  .btn-lg { --h: 3.75rem; padding: 0 1.9rem; font-size: var(--t-base); }

  /* Socials: a centred row of round outline buttons under the actions. */
  .h-social { display: flex; justify-content: center; gap: 0.5rem; margin: 0.25rem 0 0; padding: 0; list-style: none; }
  .h-social a {
    display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--ink) 16%, transparent); color: var(--ink-2);
    background: color-mix(in oklab, var(--ground) 70%, transparent);
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 160ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .h-social a:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  }
  .h-social a:active { transform: scale(0.95); }

  /* Entrance: the title rises word by word, then the lead, then each button and social link in turn. */
  .h-title .w { display: inline-block; }
  :global(html.js) .hero .h-title .w { opacity: 0.001; transform: translateY(0.4em); }
  :global(html.js) .hero.play .h-title .w {
    opacity: 1; transform: none;
    transition: opacity 700ms ease, transform 900ms var(--ease-out);
    transition-delay: calc(80ms + var(--w) * 70ms);
  }
  :global(html.js) .hero .h-lead { opacity: 0.001; transform: translateY(14px); }
  :global(html.js) .hero.play .h-lead { opacity: 1; transform: none; transition: opacity 800ms ease 320ms, transform 900ms var(--ease-out) 320ms; }
  /* The rows stay put; their buttons rise one after another (backwards fill, so hover still works after). */
  :global(html.js) .hero :is(.h-actions, .h-social) { opacity: 0; }
  :global(html.js) .hero.play :is(.h-actions, .h-social) { opacity: 1; }
  :global(html.js) .hero.play .h-actions > * { animation: rise-in 700ms var(--ease-out) backwards; animation-delay: 480ms; }
  :global(html.js) .hero.play .h-actions > :nth-child(2) { animation-delay: 570ms; }
  :global(html.js) .hero.play .h-social li { animation: rise-in 600ms var(--ease-out) backwards; animation-delay: 680ms; }
  :global(html.js) .hero.play .h-social li:nth-child(2) { animation-delay: 740ms; }
  :global(html.js) .hero.play .h-social li:nth-child(3) { animation-delay: 800ms; }

  /* Coming back from another page of the site: the same sequence, shorter and quieter. */
  :global(html.js.nav-internal) .hero .h-title .w { transform: translateY(0.2em); }
  :global(html.js.nav-internal) .hero.play .h-title .w { transform: none; transition-duration: 450ms, 550ms; transition-delay: calc(var(--w) * 40ms); }
  :global(html.js.nav-internal) .hero.play .h-lead { transition-duration: 450ms, 550ms; transition-delay: 160ms; }
  :global(html.js.nav-internal) .hero.play .h-actions > * { animation-duration: 500ms; animation-delay: 240ms; }
  :global(html.js.nav-internal) .hero.play .h-actions > :nth-child(2) { animation-delay: 290ms; }
  :global(html.js.nav-internal) .hero.play .h-social li { animation-duration: 450ms; animation-delay: 340ms; }

  /* ---------- The wall ---------- */
  .scene {
    position: relative; height: clamp(22rem, 40vw, 42rem); margin-top: var(--s-2);
    /* A soft pool of warm light on the page where the wall stands. */
    background: radial-gradient(55% 60% at 45% 45%, color-mix(in oklab, var(--wood-hi) 22%, transparent), transparent 75%);
  }
  .scene :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; opacity: 0; transition: opacity 600ms ease; }
  .scene.gl-ready :global(canvas) { opacity: 1; }
  .fallback { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity 600ms ease; }
  .f0 { stop-color: color-mix(in oklab, var(--wood-hi) 88%, white); }
  .f1 { stop-color: color-mix(in oklab, var(--wood-hi) 70%, var(--wood-lo)); }
  .front { fill: url(#slatFront); }
  .top { fill: color-mix(in oklab, var(--wood-hi) 75%, white); }
  .side { fill: color-mix(in oklab, var(--wood-hi) 55%, var(--wood-lo)); }
  .sh { fill: rgb(40 22 10 / 0.26); }
  /* With JS, the drawing only shows if WebGL is missing. */
  :global(html.js) .scene:not(.no-gl) .fallback { opacity: 0; }
  /* On touch devices the blurred shadow layer is the costly part of the drawing: plain shadows instead. */
  @media (pointer: coarse) {
    .fallback g[filter] { filter: none; }
    .sh { fill: rgb(40 22 10 / 0.12); }
  }

  /* Every screen: the hero is exactly the visible height below the header; the wall takes
     whatever height the copy leaves, so the next section always starts below the fold. */
  /* A minimum, never a fixed height: on short screens (landscape phones, small laptop windows) the copy plus
     the wall's minimum is taller than the screen, and a fixed height made overflow: clip cut the wall off.
     Now the hero grows instead, so the wall is always drawn whole. */
  .hero { display: flex; flex-direction: column; min-height: max(calc(100svh - var(--header-h)), 30rem); }
  .scene { flex: 1 1 auto; height: auto; min-height: 12rem; }
  @media (min-width: 761px) {
    .hero { min-height: max(calc(100svh - var(--header-h)), 38rem); padding-top: clamp(3rem, 11vh, 7rem); }
    .scene { min-height: 20rem; }
  }
  /* Short and wide (phones on their side, low windows): less space above the copy, a modest wall. */
  @media (min-width: 761px) and (max-height: 560px) {
    .hero { min-height: 0; padding-top: 1.5rem; }
    .scene { flex: 0 0 auto; height: clamp(14rem, 55vh, 20rem); min-height: 0; margin-top: var(--s-2); }
  }
  /* Phones: text and wall sit together as one centred group; spare height goes above and below it. */
  @media (max-width: 760px) {
    .hero { justify-content: center; gap: 1.25rem; padding-top: 0; }
    .scene { flex: 0 0 auto; height: min(68vw, 22rem); min-height: 0; margin-top: 0; }
  }
  /* Small screens: compact buttons, side by side when they fit. */
  @media (max-width: 620px) {
    .h-actions { width: 100%; gap: 0.6rem; }
    .h-actions :global(.btn) { --h: 2.9rem; flex: 1 1 auto; padding: 0 1.15rem; font-size: var(--t-sm); }
    .hero-copy { gap: 0.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero :is(.h-lead, .h-actions, .h-social), :global(html.js) .hero .h-title .w { transform: none; }
    :global(html.js) .hero.play .h-title .w, :global(html.js) .hero.play .h-lead { transition: opacity 400ms ease; transition-delay: 0ms; }
    :global(html.js) .hero.play :is(.h-actions > *, .h-social li) { animation: none; }
    :global(html.js) .hero.play :is(.h-actions, .h-social) { transition: opacity 400ms ease 150ms; }
  }
</style>

<script is:inline>
  // The entrance starts from here, not from the bundled script below, so the headline and lead are on screen
  // as soon as the web fonts are in (or after 400ms at most): the visible text never waits on JavaScript.
  (function () {
    var hero = document.querySelector("[data-hero]");
    if (!hero) return;
    var go = function () { requestAnimationFrame(function () { requestAnimationFrame(function () { hero.classList.add("play"); }); }); };
    if (document.fonts && document.fonts.ready) Promise.race([document.fonts.ready, new Promise(function (r) { setTimeout(r, 400); })]).then(go);
    else go();
  })();
</script>

<script>
  const scene = document.querySelector<HTMLElement>("[data-hero] [data-scene]")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The 3D wall is decoration: it loads once the page itself has loaded and the main thread is free, so it
  // never competes with the text and the first paint. Without WebGL, three.js throws and the drawing stays.
  const mount = async () => {
    try {
      const { mountSlatWall, wallQuality } = await import("../lib/slatwall-host");
      const quality = wallQuality();
      if (quality === "off") throw new Error("weak device: keep the flat drawing");
      const wood = getComputedStyle(document.documentElement).getPropertyValue("--wood-hi").trim() || "#d8b98f";
      await mountSlatWall(scene, {
        reduce,
        quality,
        woodColor: wood,
        onReady: () => {
          scene.classList.add("gl-ready");
          // The flat drawing is hidden behind the canvas now: drop its few hundred nodes once it has faded.
          setTimeout(() => scene.querySelector(".fallback")?.remove(), 700);
        },
      });
    } catch {
      scene.classList.add("no-gl");
    }
  };
  const idle = (fn: () => void) => ("requestIdleCallback" in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 1));
  if (document.readyState === "complete") idle(mount);
  else addEventListener("load", () => idle(mount), { once: true });
</script>
