---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, useT, altPath } from '../i18n/ui';
import { API_URL } from '../lib/data';

interface Props { lang: Lang; title?: string; description?: string; current?: string; noindex?: boolean }
const { lang, title, description, current = '', noindex = false } = Astro.props;
const t = useT(lang);
const pageTitle = title ? `${title} | Symmetry` : t('meta.title');
const desc = description ?? t('meta.description');
const here = Astro.url.pathname;
const site = Astro.site ?? new URL('https://symmetry.ge');
---
<!doctype html>
<html lang={lang} data-palette="oak">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(here, site)} />
    <link rel="alternate" hreflang="ka" href={new URL(altPath(here, 'ka'), site)} />
    <link rel="alternate" hreflang="en" href={new URL(altPath(here, 'en'), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(altPath(here, 'ka'), site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ka' ? 'ka_GE' : 'en_US'} />
    <meta name="theme-color" content="#f1ebe1" />
    <link rel="preload" href="/fonts/firago/FiraGO-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/firago/FiraGO-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/firago/FiraGO-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        // Arriving from another page of this site: the page should simply be there, not replay its intro.
        try { if (document.referrer && new URL(document.referrer).origin === location.origin) html.classList.add('nav-internal'); } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Fragment set:html={`<!--
THESIS: The catalogue is a veneer specimen book. Symmetry = book-matching: two leaves of one relief, mirrored on a spine. Refuses the full-bleed photo hero + three icon cards of every decor site.
OWN-WORLD: One palette, white oak ground with deep dark oak; code-drawn parametric reliefs shaded from --wood-lo to --wood-hi; Bodoni Moda / Noto Serif Georgian display, Manrope / Noto Sans Georgian text; hairline dimension callouts; italic specimen numbers; notch-marked selection.
STORY: Visitor sees the material at scale, understands it is computed and made in Georgia, picks a pattern and a size, sees the price, requests an order or messages on WhatsApp.
FIRST VIEWPORT: 12-col grid. Cols 1-5: headline at --t-4xl, lead, two actions (products, contact). Cols 6-12: book-matched leaf pair opening from the spine, dimension lines, specimen caption.
FORM: Veneer Specimen Book, grounded list #2 (my pick; user-chosen). Seed key abd694da. Raises: Swiss master grid with stepped type; dimension leader callouts; notch-not-hue selection.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`} />
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} current={current} />
    <script is:inline data-track={`${API_URL}/track`} data-lang={lang}>
      // Anonymous visit counter for the admin's metrics: no cookies, no IP, no personal data.
      // The visitor is a random id kept in this browser; page views, product views and contact-link clicks are sent.
      (function () {
        var me = document.currentScript, url = me && me.dataset.track;
        if (!url || !navigator.sendBeacon) return;
        var v;
        try {
          v = localStorage.getItem('symmetry:v');
          if (!v) { v = Array.from(crypto.getRandomValues(new Uint8Array(8)), function (b) { return b.toString(16).padStart(2, '0'); }).join(''); localStorage.setItem('symmetry:v', v); }
        } catch (e) { return; }
        var base = { v: v, l: me.dataset.lang, p: location.pathname };
        // text/plain keeps the beacon a "simple" request (no CORS preflight).
        var send = function (data) {
          var b = Object.assign({}, base, data);
          try { navigator.sendBeacon(url, new Blob([JSON.stringify(b)], { type: 'text/plain' })); } catch (e) {}
        };
        // The view is counted once the page has loaded, so the beacon never competes with fonts and images.
        var views = function () {
          send({ k: 'page', r: document.referrer });
          var pdp = document.querySelector('[data-pdp][data-product-id]');
          if (pdp) send({ k: 'product', pid: Number(pdp.getAttribute('data-product-id')) });
        };
        if (document.readyState === 'complete') setTimeout(views, 0);
        else addEventListener('load', function () { setTimeout(views, 0); }, { once: true });
        var channel = function (href) {
          if (/^https?:\/\/(wa\.me|api\.whatsapp\.com)\//i.test(href)) return 'whatsapp';
          if (/^tel:/i.test(href)) return 'phone';
          if (/^mailto:/i.test(href)) return 'email';
          var m = href.match(/^https?:\/\/(?:www\.)?(instagram|facebook|tiktok)\.com/i);
          return m ? m[1].toLowerCase() : '';
        };
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          var c = a && channel(a.getAttribute('href') || '');
          if (c) send({ k: 'contact', d: c });
        }, true);
      })();
    </script>
    <script is:inline>
      // Set the header's scrolled state without its 400ms background fade: used whenever a page opens
      // already scrolled (language switch, reload, back/forward), so the bar is solid from the first frame.
      window.__syncHeader = function () {
        var h = document.querySelector('[data-header]');
        if (!h) return;
        var on = scrollY > 12;
        if (h.hasAttribute('data-scrolled') === on) return;
        h.style.transition = 'none';
        h.toggleAttribute('data-scrolled', on);
        void h.offsetHeight; // commit the new style before transitions come back
        requestAnimationFrame(function () { requestAnimationFrame(function () { h.style.transition = ''; }); });
      };
    </script>
    <script is:inline>
      // Language switch: reopen at the same block the visitor was reading (saved in Header.astro).
      (function () {
        var s;
        try { s = JSON.parse(sessionStorage.getItem('symmetry:spot') || 'null'); sessionStorage.removeItem('symmetry:spot'); } catch (e) { return; }
        if (!s || s.to !== location.pathname || Date.now() - s.t > 15000) return;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var moved = false;
        var stop = function () { moved = true; };
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (ev) { addEventListener(ev, stop, { once: true, passive: true }); });
        var place = function () {
          if (moved) return;
          var doc = document.documentElement;
          var top;
          if (s.end) top = doc.scrollHeight;
          else {
            var blocks = document.querySelectorAll('main > *, body > footer');
            var b = blocks[Math.min(s.i, blocks.length - 1)];
            if (!b) return;
            var head = document.querySelector('[data-header]');
            var r = b.getBoundingClientRect();
            top = scrollY + r.top + r.height * s.f - ((head ? head.offsetHeight : 0) + 1);
          }
          doc.style.scrollBehavior = 'auto';
          scrollTo(0, Math.max(0, top));
          doc.style.scrollBehavior = '';
          window.__syncHeader();
        };
        place();
        // Web fonts and images can shift heights after this; settle again once they have loaded.
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);
        addEventListener('load', place, { once: true });
        // Late layout shifts (styles, images) during the first moments: follow them until the visitor scrolls.
        if (window.ResizeObserver) {
          var ro = new ResizeObserver(function () { place(); });
          ro.observe(document.body);
          setTimeout(function () { ro.disconnect(); }, 2500);
        }
      })();
    </script>
    <script is:inline>
      // Back to the catalogue from a product page (link or nav, not the browser's Back button, which
      // restores on its own): reopen at the same scroll position, before the first paint.
      (function () {
        var c, ref;
        try { c = JSON.parse(sessionStorage.getItem('symmetry:catalogue') || 'null'); ref = new URL(document.referrer); } catch (e) { return; }
        if (!c || c.url !== location.pathname + location.search || Date.now() - c.t > 30 * 60 * 1000) return;
        if (ref.origin !== location.origin || !/\/products\/[^/]+\/?$/.test(ref.pathname)) return;
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'back_forward') return;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var moved = false;
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (ev) { addEventListener(ev, function () { moved = true; }, { once: true, passive: true }); });
        var place = function () {
          if (moved) return;
          var doc = document.documentElement;
          doc.style.scrollBehavior = 'auto';
          scrollTo(0, c.y);
          doc.style.scrollBehavior = '';
          window.__syncHeader();
        };
        place();
        // The type filter and web fonts can change heights after this; settle again when they have.
        document.addEventListener('DOMContentLoaded', place, { once: true });
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);
        addEventListener('load', place, { once: true });
        // Late layout shifts (styles, images) during the first moments: follow them until the visitor scrolls.
        if (window.ResizeObserver) {
          var ro = new ResizeObserver(function () { place(); });
          ro.observe(document.body);
          setTimeout(function () { ro.disconnect(); }, 2500);
        }
      })();
    </script>
    <script is:inline>
      // The header gets its solid background before first paint whenever the page opens scrolled
      // (language switch, back/forward, reload), so content never shows through or above it.
      window.__syncHeader();
      // The browser may restore the scroll position itself (reload, back/forward) after this runs.
      addEventListener('pageshow', function () { window.__syncHeader(); });
      addEventListener('load', function () { requestAnimationFrame(window.__syncHeader); });
    </script>
    <script is:inline>
      // Reveal on scroll. Inline (not a bundled module) so content in the first screen fades in as soon as the
      // page is parsed, instead of staying hidden until a script file has downloaded.
      (function () {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        var watch = function () { document.querySelectorAll('[data-reveal]:not(.is-in)').forEach(function (el) { io.observe(el); }); };
        watch();
        document.addEventListener('symmetry:content', watch);
      })();
    </script>
  </body>
</html>
