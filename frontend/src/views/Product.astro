---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Leaf from '../components/Leaf.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { type Lang, useT, path } from '../i18n/ui';
import { saleEndText } from '../lib/saleDate';
import { type Product, loadData, loc, priceFmt, waLink, telLink, API_URL, nowPrice, onSale, sizeOnSale, dimensionOf, kindOf, typeName, dimensionName } from '../lib/data';

interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const t = useT(lang);
const { products, settings: s } = await loadData();
// With online payment on, the order flow is a purchase: contact details, then Flitt's checkout.
const pays = !!s.payments;
// Out of stock: no buying, only ways to ask when it will be available. Re-checked live in the browser below.
const inStock = p.in_stock !== false;
// Sale (per size): shown on build, then re-checked live (a sale can start or end after the site was built).
const sale = onSale(p);
const saleUntil = sale ? saleEndText(p.sale!.ends_at, lang) : '';
const index = products.findIndex((x) => x.slug === p.slug);
const name = loc(p.name, lang);
const first = p.sizes[0];
// The sale pill starts with the first (pre-selected) size's own discount.
const firstPct = first && sizeOnSale(first) ? first.sale_percent ?? 0 : 0;
const others = products.filter((x) => x.slug !== p.slug).slice(0, 3);
const hasPhoto = p.images.length > 0;
const sizeLabel = (w: number, h: number) => `${w} × ${h} ${t('p.cm')}`;
/** Most pieces per order (same limit as the API); bigger runs go through the contact form. */
const QTY_MAX = 10;
const days = p.delivery_days.min === p.delivery_days.max ? `${p.delivery_days.min}` : `${p.delivery_days.min}–${p.delivery_days.max}`;
const waBase = `${t('p.waText')} «${name}»`;
const waStock = `${t('p.waStock')} «${name}»?`;
const installH = Math.floor((p.installation_minutes ?? 0) / 60);
const installM = (p.installation_minutes ?? 0) % 60;
const installTime = [installH ? `${installH} ${t('p.hours')}` : '', installM ? `${installM} ${t('p.minutes')}` : ''].filter(Boolean).join(' ') || '—';
const socials = [
  { key: 'instagram', href: s.instagram, label: 'Instagram' },
  { key: 'facebook', href: s.facebook, label: 'Facebook' },
  { key: 'tiktok', href: s.tiktok, label: 'TikTok' },
].filter((x) => x.href);
---
<Base lang={lang} title={name} description={loc(p.short, lang)} current="products">
  <div class="wrap crumbs">
    <a class="back" href={path(lang, '/products/')}><Icon name="arrow-left" size={18} />{t('p.back')}</a>
  </div>

  <section class="wrap grid pdp" data-pdp data-lang={lang} data-product-id={p.id} data-slug={p.slug} data-api={API_URL} data-stock={inStock ? 'in' : 'out'} data-wa={s.whatsapp} data-wa-base={waBase} data-qty-text={JSON.stringify({ pcs: t('p.pcs'), each: t('p.each') })}>
    <div class="media">
      <figure class="stage" data-stage>
        <div class="frame-box">
          <div class="piece" data-frame style={`--r:${first ? (first.width / first.height).toFixed(4) : 1.5}`}>
            <div class="frame">
              <Leaf product={p} alt={name} ratio={first ? first.width / first.height : 1.5} eager />
            </div>
            {p.images.length > 1 && (
              <>
                <button type="button" class="nav nav-prev" data-nav="-1" aria-label={t('p.prev')}><Icon name="chevron-left" size={20} /></button>
                <button type="button" class="nav nav-next" data-nav="1" aria-label={t('p.next')}><Icon name="chevron-right" size={20} /></button>
                <span class="count num" aria-live="polite"><span data-count>1</span> / {p.images.length}</span>
              </>
            )}
            <div class="dim dim-ends dim-top num"><span data-dim-w>{first?.width} {t('p.cm')}</span></div>
            <div class="dim-side num"><span class="dim-v" data-dim-h>{first?.height} {t('p.cm')}</span></div>
          </div>
        </div>
        {!hasPhoto && <figcaption class="illus label">{t('p.illustration')}</figcaption>}
      </figure>
      {p.images.length > 1 && (
        <div class="thumbs">
          {p.images.map((img, i) => (
            <button type="button" class="thumb" data-thumb={img.url} aria-label={`${name} ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}>
              <img src={img.url} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="info">
      <div class="title" data-reveal>
        <h1 class="display t-2xl">{name}</h1>
        <span class="sale-pill num" data-sale-pill hidden={!firstPct}>
          <span class="sale-pct" data-sale-pct>−{firstPct}%</span>
          <span class="sale-txt">
            <span class="sale-name">{t('sale.badge')}</span>
            <span class="sale-until" data-sale-until hidden={!saleUntil}>{saleUntil}</span>
          </span>
        </span>
        <span class="stock-badge in" data-when="in">{t('p.inStock')}</span>
        <span class="stock-badge out" data-when="out">{t('p.outOfStock')}</span>
      </div>
      <p class="lead" data-reveal style="--d:1">{loc(p.short, lang)}</p>

      <fieldset class="sizes" data-reveal style="--d:2">
        <legend class="label">{t('p.chooseSize')}</legend>
        {p.sizes.map((sz, i) => (
          <label class="size">
            <input
              type="radio"
              name="size"
              value={sz.id}
              checked={i === 0}
              data-w={sz.width}
              data-h={sz.height}
              data-price={nowPrice(sz)}
              data-old={sizeOnSale(sz) ? sz.price : ''}
              data-pct={sizeOnSale(sz) ? sz.sale_percent : ''}
              data-label={sizeLabel(sz.width, sz.height)}
            />
            <span class="notch" aria-hidden="true"></span>
            <span class="sz num">{sizeLabel(sz.width, sz.height)}</span>
            <span class="pr num">{sizeOnSale(sz) && <><s class="was">₾ {priceFmt(sz.price)}</s><span class="sz-pct">−{sz.sale_percent}%</span></>}<span data-pr>₾ {priceFmt(nowPrice(sz))}</span></span>
          </label>
        ))}
      </fieldset>

      <div class="stock-box" data-when="out" data-reveal style="--d:3">
        <p class="stock-t">{t('p.outTitle')}</p>
        <p class="stock-d">{t('p.outText')}</p>
        <div class="quick">
          {s.whatsapp && (
            <a class="btn btn-solid" href={waLink(s.whatsapp, waStock)} target="_blank" rel="noopener"><Icon name="whatsapp" />{t('p.outAsk')}</a>
          )}
          {s.phone && <a class="btn btn-line num" href={telLink(s.phone)}><Icon name="phone" />{s.phone}</a>}
          <a class="btn btn-line" href={path(lang, '/contact/')}><Icon name="mail" />{t('p.contactUs')}</a>
        </div>
      </div>

      <div class="buy" data-when="in" data-reveal style="--d:3">
        {/* How many pieces of this design and size: the price below is the total. */}
        <div class="qty-row">
          <label class="label" for="pdp-qty">{t('p.qty')}</label>
          <div class="qty">
            <button class="qty-b" type="button" data-qty-step="-1" aria-label={t('p.qtyLess')} disabled>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </button>
            <input id="pdp-qty" class="num" type="number" inputmode="numeric" min="1" max={QTY_MAX} step="1" value="1" data-qty />
            <button class="qty-b" type="button" data-qty-step="1" aria-label={t('p.qtyMore')}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </button>
          </div>
          <span class="qty-each num" data-each hidden></span>
        </div>
        <div class="price-row">
          <div class="price-box">
            <span class="label" data-price-label data-one={t('p.price')} data-many={t('p.total')}>{t('p.price')}</span>
            <s class="was was-lg num" data-was hidden={!firstPct}>{first && firstPct ? `₾ ${priceFmt(first.price)}` : ''}</s>
            <span class="price display num" data-total aria-live="polite">₾ {first ? priceFmt(nowPrice(first)) : ''}</span>
          </div>
          <button class="btn btn-solid order-btn" type="button" data-order-open>{t(pays ? 'p.buy' : 'p.order')}</button>
        </div>
        <p class="note">{t(pays ? 'p.buyNote' : 'p.orderNote')}</p>
        <div class="quick">
          {s.whatsapp && (
            <a class="btn btn-line" data-wa-link href={waLink(s.whatsapp, `${waBase}, ${first ? sizeLabel(first.width, first.height) : ''}`)} target="_blank" rel="noopener">
              <Icon name="whatsapp" />{t('p.askWhatsapp')}
            </a>
          )}
          {s.phone && <a class="btn btn-line num" href={telLink(s.phone)}><Icon name="phone" />{s.phone}</a>}
        </div>
      </div>

      <dl class="specs" data-reveal style="--d:4">
        <div><dt><Icon name="shape" size={18} />{t('p.type')}</dt><dd>{kindOf(p) === 'portrait' || kindOf(p) === 'landscape' ? t(`type.${kindOf(p)}` as any) : typeName(kindOf(p), lang, 'single')}</dd></div>
        <div><dt><Icon name="shape" size={18} />{t('p.dimension')}</dt><dd>{dimensionName(dimensionOf(p), lang)}</dd></div>
        <div><dt><Icon name="grain" size={18} />{t('p.material')}</dt><dd>{loc(p.material, lang)}</dd></div>
        <div><dt><Icon name="truck" size={18} />{t('p.delivery')}</dt><dd class="num">{days} {t('p.workingDays')}</dd></div>
        <div>
          <dt><Icon name="tool" size={18} />{t('p.installation')}</dt>
          <dd class="num">{installTime}</dd>
        </div>
      </dl>

      {socials.length > 0 && (
        <div class="follow" data-reveal style="--d:5">
          <span class="label">{t('p.follow')}</span>
          <div class="soc">
            {socials.map((x) => <a href={x.href} target="_blank" rel="noopener" aria-label={x.label}><Icon name={x.key} size={20} /></a>)}
          </div>
        </div>
      )}
    </div>
  </section>

  {loc(p.description, lang) && (
    <section class="wrap grid desc" aria-labelledby="about-piece">
      <h2 class="desc-k" id="about-piece" data-reveal>{t('p.about')}</h2>
      <p class="desc-t" data-reveal style="--d:1">{loc(p.description, lang)}</p>
    </section>
  )}

  {others.length > 0 && (
    <section class="section more">
      <div class="wrap">
        <div class="more-head">
          <h2 class="display t-2xl" data-reveal>{t('p.more')}</h2>
          <a class="link-arrow" href={path(lang, '/products/')}>{t('collection.all')} <Icon name="arrow" /></a>
        </div>
        <div class="more-grid">
          {others.map((o, i) => <SpecimenCard product={o} index={products.indexOf(o)} lang={lang} ratio={0.8} d={i} />)}
        </div>
      </div>
    </section>
  )}

  <dialog class="drawer" data-order aria-labelledby="order-title">
    <div class="drawer-in">
      <div class="drawer-head">
        <h2 id="order-title" class="display t-2xl">{t(pays ? 'order.buyTitle' : 'order.title')}</h2>
        <button class="x" type="button" data-order-close aria-label={t('nav.close')}><Icon name="close" size={22} /></button>
      </div>
      <p class="drawer-lead">{t(pays ? 'order.buyLead' : 'order.lead')}</p>
      <div class="summary">
        <span class="label">{t('order.summary')}</span>
        <div class="sum-row">
          <span class="sum-name">{name}</span>
          <span class="num"><span data-sum-size>{first ? sizeLabel(first.width, first.height) : ''}</span><span data-sum-qty hidden></span></span>
          <span class="num sum-price" data-sum-price>₾ {first ? priceFmt(nowPrice(first)) : ''}</span>
        </div>
        {/* The same quantity as on the page: changing it here updates the total (and the page) live. */}
        <div class="sum-qty">
          <span class="label">{t('p.qty')}</span>
          <div class="qty qty-sm">
            <button class="qty-b" type="button" data-qty-step="-1" aria-label={t('p.qtyLess')} disabled>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </button>
            <output class="num qty-n" data-qty-out aria-live="polite">1</output>
            <button class="qty-b" type="button" data-qty-step="1" aria-label={t('p.qtyMore')}>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </button>
          </div>
          <span class="qty-each num" data-sum-each hidden></span>
        </div>
      </div>
      <LeadForm lang={lang} kind="order" />
    </div>
  </dialog>
</Base>

<style>
  /* Stock: everything marked data-when shows only for the matching state. */
  .pdp[data-stock='in'] [data-when='out'], .pdp[data-stock='out'] [data-when='in'] { display: none !important; }
  /* Sale pill in the site's accent colours. */
  .sale-pill[hidden] { display: none !important; }
  .sale-pill {
    justify-self: start; align-self: flex-start; width: fit-content;
    display: inline-flex; align-items: center; gap: 0.8rem; margin: 0.9rem 0.9rem 0.2rem 0;
    padding: 0.35rem 1.1rem 0.35rem 0.35rem; border-radius: 14px;
    background: color-mix(in oklab, var(--accent) 10%, var(--ground)); color: var(--accent);
    border: 1px solid color-mix(in oklab, var(--accent) 28%, transparent);
  }
  .sale-pct {
    display: inline-flex; align-items: center; min-height: 2.6rem; padding: 0 0.85rem; border-radius: 10px;
    background: var(--accent); color: var(--accent-ink); font-size: var(--t-xl); font-weight: 800; letter-spacing: -0.01em;
    box-shadow: 0 8px 18px -10px color-mix(in oklab, var(--accent) 80%, transparent);
  }
  .sale-txt { display: grid; gap: 0.05rem; line-height: 1.25; }
  .sale-name { font-size: var(--t-sm); font-weight: 700; color: var(--ink); }
  .sale-until { font-size: var(--t-xs); color: var(--ink-2); }
  .sale-until[hidden] { display: none; }
  /* :global — the live sale refresh redraws the size prices, and redrawn elements don't get scoped styles. */
  .pdp :global(.was) { color: var(--ink-3); font-weight: 400; text-decoration-thickness: 1px; }
  .size .pr { display: inline-flex; align-items: baseline; gap: 0.5rem; }
  .pdp :global(.sz-pct) { font-size: var(--t-xs); font-weight: 700; padding: 0.05rem 0.45rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); }
  .was[hidden] { display: none; }
  .was-lg { display: block; font-size: var(--t-base); margin: 0.1rem 0 0.2rem; }
  .stock-badge {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.6rem;
    font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.04em; color: var(--ink-2);
  }
  .stock-badge::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: oklch(0.6 0.12 150); }
  .stock-badge.out::before { background: oklch(0.58 0.16 30); }
  .stock-box { display: grid; gap: 0.6rem; padding: 1.25rem 1.35rem; border: 1px solid var(--line); border-radius: 16px; background: var(--ground-2); }
  .stock-t { font-weight: 600; font-size: var(--t-lg); color: var(--ink); margin: 0; }
  .stock-d { color: var(--ink-2); margin: 0; max-width: 46ch; text-wrap: pretty; }
  .stock-box .quick { margin-top: 0.4rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .stock-box .quick .btn { flex: 1 1 auto; width: auto; white-space: nowrap; }
  .crumbs { padding-top: var(--s-2); }
  .back { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--t-sm); color: var(--ink-2); text-decoration: none; transition: color 200ms ease; }
  @media (hover: hover) and (pointer: fine) { .back:hover { color: var(--ink); } }

  .pdp { padding-block: var(--s-2) var(--s-6); row-gap: var(--s-5); align-items: start; }
  .media { grid-column: 1 / span 7; position: sticky; top: calc(var(--header-h) + 1rem); }
  .info { grid-column: 8 / -1; display: grid; gap: clamp(0.9rem, 2.2vh, 1.6rem); align-content: start; }

  .stage { display: grid; gap: 0.9rem; animation: stage-in 800ms var(--ease-out) 80ms both; }
  /* The panel arrives once per visit: a short rise and settle; the dimension callouts follow. */
  @keyframes stage-in { from { opacity: 0; transform: translateY(14px) scale(0.985); } }
  .dim-top, .dim-side { animation: dims-in 500ms ease 550ms both; }
  @keyframes dims-in { from { opacity: 0; } }
  /* The panel sits on the page with shop-drawing callouts: width above, height to the right. */
  .frame-box { container-type: size; height: clamp(20rem, calc(100svh - var(--header-h) - 8.5rem), 44rem); display: grid; place-items: center; padding: 2rem 2.25rem 0 0; }
  .piece {
    position: relative;
    width: min(100cqw, calc(100cqh * var(--r)));
    height: min(100cqh, calc(100cqw / var(--r)));
    transition: width 700ms var(--ease-in-out), height 700ms var(--ease-in-out);
  }
  .frame { position: absolute; inset: 0; overflow: hidden; box-shadow: 0 40px 60px -35px rgb(0 0 0 / 0.55); }
  .frame :global(.leaf) { height: 100%; aspect-ratio: auto !important; }
  .dim-top { position: absolute; left: 0; right: 0; bottom: calc(100% + 0.9rem); }
  /* Height callout: line, label, line (the label sits in a gap, so no background is needed),
     with end ticks drawn as background strokes at the top and bottom. */
  .dim-side {
    position: absolute; top: 0; bottom: 0; left: calc(100% + 0.9rem); width: 1rem;
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
    color: var(--ink-3); font-size: var(--t-xs); letter-spacing: 0.08em;
    --tick: linear-gradient(color-mix(in oklab, currentColor 80%, transparent), color-mix(in oklab, currentColor 80%, transparent));
    background: var(--tick) top center / 0.5rem 1px no-repeat, var(--tick) bottom center / 0.5rem 1px no-repeat;
    padding-block: 0.5rem;
  }
  .dim-side::before, .dim-side::after { content: ''; flex: 1; width: 1px; background: currentColor; opacity: 0.55; margin-block: -0.5rem; }
  .dim-side::before { margin-bottom: 0; }
  .dim-side::after { margin-top: 0; }
  .dim-side span { white-space: nowrap; }
  .illus { color: var(--ink-3); }
  /* Gallery: arrows on the picture's edges, a counter in its corner; swipe works on touch. */
  .frame { touch-action: pan-y; }
  .frame :global(img) { user-select: none; -webkit-user-drag: none; }
  .nav {
    position: absolute; top: 50%; z-index: 2; translate: 0 -50%;
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
    background: color-mix(in oklab, var(--ground) 82%, transparent); color: var(--ink);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.14);
    transition: background-color 160ms ease, opacity 200ms ease, transform 160ms var(--ease-out);
  }
  .nav-prev { left: 0.75rem; }
  .nav-next { right: 0.75rem; }
  .nav:active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) {
    .nav { opacity: 0; }
    .piece:hover .nav, .nav:focus-visible { opacity: 1; }
    .nav:hover { background: var(--ground); }
  }
  .count {
    position: absolute; right: 0.75rem; bottom: 0.75rem; z-index: 2; padding: 0.2rem 0.6rem; border-radius: 999px;
    font-size: var(--t-xs); letter-spacing: 0.06em; color: var(--ink);
    background: color-mix(in oklab, var(--ground) 82%, transparent);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .thumbs { display: flex; gap: 0.6rem; margin-top: var(--s-2); overflow-x: auto; padding: 2px; scrollbar-width: thin; }
  .thumb { flex: 0 0 auto; width: 4.5rem; height: 4.5rem; padding: 0; border: 1px solid var(--line); background: none; cursor: pointer; overflow: hidden; transition: border-color 200ms ease, transform 160ms var(--ease-out); }
  .thumb:active { transform: scale(0.96); }
  .thumb[aria-pressed='true'] { border-color: var(--accent); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }

  .title { display: grid; gap: 0.3rem; }
  .title h1 { line-height: 1.1; }
  .info .lead { font-size: var(--t-base); line-height: 1.55; }

  .sizes { border: 0; padding: 0; display: grid; }
  .sizes legend { margin-bottom: 0.5rem; }
  .size {
    position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem;
    padding: 0.7rem 0.25rem; border-top: 1px solid var(--line); cursor: pointer; transition: background-color 200ms ease;
  }
  .size:last-of-type { border-bottom: 1px solid var(--line); }
  .size input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; appearance: none; background: none; border: 0; }
  .size .notch { width: 0.55rem; height: 0.55rem; border: 1px solid var(--ink-3); transform: rotate(45deg); transition: background-color 200ms ease, border-color 200ms ease, transform 300ms var(--ease-out); }
  .size .sz { color: var(--ink-2); transition: color 200ms ease; }
  .size .pr { color: var(--ink-3); font-size: var(--t-sm); transition: color 200ms ease; }
  .size:has(input:checked) .notch { background: var(--accent); border-color: var(--accent); transform: rotate(45deg) scale(1.15); }
  .size:has(input:checked) .sz, .size:has(input:checked) .pr { color: var(--ink); }
  .size:has(input:focus-visible) { outline: 1.5px solid var(--accent); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .size:hover { background: color-mix(in oklab, var(--ink) 4%, transparent); } }

  .buy { display: grid; gap: 0.75rem; }
  /* Quantity: a compact stepper; the price under it is the total for all pieces. */
  .qty-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .qty { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; background: var(--ground); }
  .qty-b {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; border: 0; border-radius: 50%;
    background: none; color: var(--ink); cursor: pointer; transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .qty-b:active:not(:disabled) { transform: scale(0.92); }
  .qty-b:disabled { color: var(--ink-3); opacity: 0.45; cursor: default; }
  @media (hover: hover) and (pointer: fine) { .qty-b:not(:disabled):hover { background: color-mix(in oklab, var(--ink) 6%, transparent); } }
  .qty input {
    width: 3rem; height: 2.75rem; padding: 0; border: 0; background: none; color: var(--ink);
    font: inherit; font-size: var(--t-base); font-weight: 600; text-align: center; appearance: textfield; -moz-appearance: textfield;
  }
  .qty input::-webkit-inner-spin-button, .qty input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .qty input:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 6px; }
  .qty-b:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .qty-each { font-size: var(--t-sm); color: var(--ink-3); }
  /* Price and the main action share one row, so the whole decision sits in one glance. */
  .price-row { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 1.25rem; }
  .price-box { display: grid; gap: 0.2rem; }
  .price { font-size: var(--t-2xl); line-height: 1; letter-spacing: -0.02em; white-space: nowrap; }
  .order-btn { width: 100%; --h: 3.4rem; font-size: var(--t-base); }
  .note { font-size: var(--t-xs); color: var(--ink-3); }
  /* Secondary contact: two compact buttons side by side, icon tight to its label. */
  .quick { display: grid; grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr)); gap: 0.6rem; }
  .quick .btn { --h: 2.75rem; padding-inline: 1rem; gap: 0.5rem; font-size: var(--t-sm); }
  .quick .btn :global(svg) { width: 1.05em; height: 1.05em; }

  .specs { display: grid; }
  .specs div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding-block: 0.9rem; border-top: 1px solid var(--line); font-size: var(--t-sm); }
  .specs dt { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink-3); }
  .specs dt :global(.icon) { color: var(--accent); }
  .specs dd { color: var(--ink); }

  .follow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .soc { display: flex; gap: 0.25rem; }
  .soc a { display: inline-flex; width: 2.5rem; height: 2.5rem; align-items: center; justify-content: center; color: var(--ink-2); border-radius: 50%; transition: color 200ms ease, background-color 200ms ease; }
  @media (hover: hover) and (pointer: fine) { .soc a:hover { color: var(--ink); background: var(--ground-2); } }

  /* About the piece: an editorial note on the page grid. Label left (on the photo's edge), text left-aligned on the right. */
  .desc { padding-block: var(--s-5) var(--s-6); row-gap: var(--s-2); align-items: start; }
  .desc::before { content: ''; grid-column: 1 / -1; border-top: 1px solid var(--line); margin-bottom: var(--s-3); }
  .desc-k { grid-column: 1 / span 3; font-family: var(--f-text); font-size: var(--t-sm); font-weight: 500; color: var(--ink-3); padding-top: 0.45em; }
  .desc-t {
    grid-column: 5 / -1; max-width: 58ch; text-align: left; text-wrap: pretty;
    font-family: var(--f-display); font-size: var(--t-xl); line-height: 1.5; letter-spacing: -0.01em; color: var(--ink);
  }
  :lang(ka) .desc-t { font-size: var(--t-lg); line-height: 1.75; letter-spacing: 0; }

  .more { background: var(--ground-2); border-top: 1px solid var(--line); }
  .more-head { display: grid; justify-items: center; text-align: center; gap: var(--s-2); margin-bottom: var(--s-5); }
  .more-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }

  /* Order drawer */
  .drawer {
    margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(36rem, 100vw); max-width: 100vw;
    border: 0; border-left: 1px solid var(--line); padding: 0; background: var(--ground); color: var(--ink);
    transform: none; transition: transform 460ms var(--ease-drawer), overlay 460ms allow-discrete, display 460ms allow-discrete;
  }
  .drawer:not([open]) { transform: translateX(100%); }
  @starting-style { .drawer[open] { transform: translateX(100%); } }
  .drawer::backdrop { background: rgb(0 0 0 / 0.5); opacity: 1; transition: opacity 400ms ease, overlay 400ms allow-discrete, display 400ms allow-discrete; }
  .drawer:not([open])::backdrop { opacity: 0; }
  @starting-style { .drawer[open]::backdrop { opacity: 0; } }
  .drawer-in { padding: var(--s-4) clamp(1.25rem, 4vw, 2.5rem) var(--s-5); display: grid; gap: var(--s-3); }
  .drawer-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .x { width: 2.75rem; height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; background: none; border: 1px solid var(--line); border-radius: 50%; cursor: pointer; transition: transform 160ms var(--ease-out), border-color 200ms ease; }
  .x:active { transform: scale(0.94); }
  .drawer-lead { color: var(--ink-2); }
  .summary { display: grid; gap: 0.6rem; padding: 1.1rem 1.25rem; background: var(--ground-2); border-radius: 16px; }
  .sum-row { display: grid; grid-template-columns: 1fr auto; gap: 0.3rem 1rem; }
  .sum-name { font-family: var(--f-display); font-size: var(--t-lg); grid-column: 1 / -1; }
  .sum-price { font-weight: 600; }
  .sum-qty { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.85rem; padding-top: 0.75rem; border-top: 1px solid var(--line); }
  .qty-sm .qty-b { width: 2.25rem; height: 2.25rem; }
  .qty-n { min-width: 2.25rem; text-align: center; font-weight: 600; }

  @media (max-width: 1000px) {
    .media { grid-column: 1 / -1; position: static; }
    .info { grid-column: 1 / -1; gap: var(--s-3); }
    .frame-box { height: min(60vh, 34rem); }
    .desc-k, .desc-t { grid-column: 1 / -1; }
  }
  /* Short laptop screens: tighten rows so price, action and specs still fit without scrolling. */
  @media (min-width: 1001px) and (max-height: 780px) {
    .size { padding-block: 0.5rem; }
    .order-btn { --h: 3rem; }
    .quick .btn { --h: 2.5rem; }
  }
  @media (max-width: 760px) {
    .more-grid { grid-template-columns: 1fr 1fr; }
    .more-grid > :global(:nth-child(3)) { display: none; }
  }
  @media (max-width: 520px) {
    .frame-box { height: 86vw; padding-right: 1.9rem; }
    .specs div { grid-template-columns: 1fr; gap: 0.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .piece { transition: none; }
    .stage { animation: dims-in 300ms ease both; }
    .drawer { transition: opacity 200ms ease, overlay 200ms allow-discrete, display 200ms allow-discrete; }
    .drawer:not([open]) { transform: none; opacity: 0; }
    @starting-style { .drawer[open] { transform: none; opacity: 0; } }
  }
</style>

<script>
  import { saleEndText } from '../lib/saleDate';
  const root = document.querySelector<HTMLElement>('[data-pdp]');
  if (root) {
    const fmt = (n: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(n).replace(/,/g, ' ');
    // The big total. (Not [data-price]: every size option carries that attribute with its own price.)
    const priceEl = root.querySelector<HTMLElement>('[data-total]')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]');
    const dimW = root.querySelector<HTMLElement>('[data-dim-w]');
    const dimH = root.querySelector<HTMLElement>('[data-dim-h]');
    const wa = root.querySelector<HTMLAnchorElement>('[data-wa-link]');
    const drawer = document.querySelector<HTMLDialogElement>('[data-order]')!;
    const form = drawer.querySelector<HTMLFormElement>('form')!;
    const sumSize = drawer.querySelector<HTMLElement>('[data-sum-size]')!;
    const sumPrice = drawer.querySelector<HTMLElement>('[data-sum-price]')!;
    const unit = dimW?.textContent?.replace(/[\d\s]/g, '').trim() || 'cm';

    const wasEl = root.querySelector<HTMLElement>('[data-was]');
    const pill = root.querySelector<HTMLElement>('[data-sale-pill]');
    // Quantity: the shown price, the order summary and the request are all for this many pieces.
    const qtyInput = root.querySelector<HTMLInputElement>('[data-qty]');
    const qtyMax = Number(qtyInput?.max) || 10;
    const eachEl = root.querySelector<HTMLElement>('[data-each]');
    const priceLabel = root.querySelector<HTMLElement>('[data-price-label]');
    const sumQty = drawer.querySelector<HTMLElement>('[data-sum-qty]');
    const text = JSON.parse(root.dataset.qtyText || '{}') as { pcs: string; each: string };
    let qty = 1;
    // The page's stepper and the one in the order summary are the same control: both update everything.
    const steppers = [...document.querySelectorAll<HTMLButtonElement>('[data-qty-step]')];
    const qtyOut = drawer.querySelector<HTMLElement>('[data-qty-out]');
    const sumEach = drawer.querySelector<HTMLElement>('[data-sum-each]');
    // Totals count to their new value (quick, eased) instead of jumping, so a growing count reads as growing.
    const reduceTotals = matchMedia('(prefers-reduced-motion: reduce)');
    const tweens = new WeakMap<HTMLElement, number>();
    const showMoney = (el: HTMLElement, to: number) => {
      const from = Number(el.dataset.v ?? to);
      el.dataset.v = String(to);
      cancelAnimationFrame(tweens.get(el) ?? 0);
      if (from === to || reduceTotals.matches) { el.textContent = `₾ ${fmt(to)}`; return; }
      const t0 = performance.now(), dur = 320;
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / dur), e = 1 - (1 - k) ** 3;
        el.textContent = `₾ ${fmt(Math.round(from + (to - from) * e))}`;
        if (k < 1) tweens.set(el, requestAnimationFrame(tick));
      };
      tweens.set(el, requestAnimationFrame(tick));
    };
    const apply = (input: HTMLInputElement) => {
      const { w, h, price, label, old } = input.dataset;
      const total = Number(price) * qty;
      showMoney(priceEl, total);
      if (wasEl) { wasEl.hidden = !old; if (old) showMoney(wasEl, Number(old) * qty); else wasEl.textContent = ''; }
      if (eachEl) { eachEl.hidden = qty < 2; eachEl.textContent = `₾ ${fmt(Number(price))} · ${text.each}`; }
      if (sumEach) { sumEach.hidden = qty < 2; sumEach.textContent = `₾ ${fmt(Number(price))} · ${text.each}`; }
      if (qtyOut) qtyOut.textContent = String(qty);
      if (priceLabel) priceLabel.textContent = (qty > 1 ? priceLabel.dataset.many : priceLabel.dataset.one) || '';
      if (sumQty) { sumQty.hidden = qty < 2; sumQty.textContent = ` × ${qty} ${text.pcs}`; }
      (form.elements.namedItem('quantity') as HTMLInputElement).value = String(qty);
      // The sale pill shows the selected size's own discount.
      if (pill) {
        pill.hidden = !input.dataset.pct;
        const pctEl = pill.querySelector('[data-sale-pct]');
        if (pctEl && input.dataset.pct) pctEl.textContent = `−${input.dataset.pct}%`;
      }
      if (dimW) dimW.textContent = `${w} ${unit}`;
      if (dimH) dimH.textContent = `${h} ${unit}`;
      sumSize.textContent = label || '';
      showMoney(sumPrice, total);
      (form.elements.namedItem('size_id') as HTMLInputElement).value = input.value;
      if (wa && root.dataset.wa) {
        const msg = `${root.dataset.waBase}, ${label}${qty > 1 ? `, ${qty} ${text.pcs}` : ''}`;
        wa.href = `https://wa.me/${root.dataset.wa.replace(/\D/g, '')}?text=${encodeURIComponent(msg)}`;
      }
    };

    const setQty = (n: number, animate = false) => {
      const next = Math.min(qtyMax, Math.max(1, Math.round(n) || 1));
      const changed = next !== qty;
      qty = next;
      if (qtyInput) qtyInput.value = String(qty);
      steppers.forEach((b) => {
        b.disabled = Number(b.dataset.qtyStep) < 0 ? qty <= 1 : qty >= qtyMax;
      });
      const sel = root.querySelector<HTMLInputElement>('input[name="size"]:checked');
      if (sel) apply(sel);
      if (animate && changed && qtyOut && !reduceTotals.matches)
        qtyOut.animate([{ transform: 'scale(1.25)' }, { transform: 'none' }], { duration: 220, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
    };
    steppers.forEach((b) => b.addEventListener('click', () => setQty(qty + Number(b.dataset.qtyStep), true)));
    // Typing: the total follows every keystroke. Above the limit the field shows the limit at once (instead
    // of keeping an old total until the field is left); an empty field or 0 waits for the next digit, and
    // leaving the field settles on at least 1.
    qtyInput?.addEventListener('input', () => {
      const digits = qtyInput.value.replace(/\D/g, '');
      const n = Number(digits);
      if (!digits || n < 1) return;
      setQty(Math.min(n, qtyMax), n > qtyMax);
    });
    qtyInput?.addEventListener('change', () => setQty(Number(qtyInput.value)));
    qtyInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); setQty(Number(qtyInput.value)); } });

    const checked = root.querySelector<HTMLInputElement>('input[name="size"]:checked');
    (form.elements.namedItem('product_id') as HTMLInputElement).value = root.dataset.productId || '';
    if (checked) apply(checked);
    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'size') {
        apply(t);
        // Feedback: the new price settles in place.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          priceEl.animate([{ opacity: 0.3, transform: 'translateY(5px)' }, { opacity: 1, transform: 'none' }], { duration: 240, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
      }
    });

    // "All products" goes back to the catalogue as the visitor left it (filter + scroll, see Base.astro).
    try {
      const back = document.querySelector<HTMLAnchorElement>('a.back');
      const c = JSON.parse(sessionStorage.getItem('symmetry:catalogue') || 'null');
      if (back && c && new URL(c.url, location.href).pathname === back.pathname) back.href = c.url;
    } catch {}

    // Gallery thumbs
    const mainImg = root.querySelector<HTMLImageElement>('.frame img');
    // The picture is always shown whole, in its own proportions; choosing a size only changes the
    // dimension labels, never the crop.
    const fitPhoto = (animate: boolean) => {
      if (!frame || !mainImg?.naturalWidth) return;
      if (!animate) frame.style.transition = 'none';
      frame.style.setProperty('--r', String(mainImg.naturalWidth / mainImg.naturalHeight));
      if (!animate) { frame.offsetWidth; frame.style.transition = ''; }
    };
    if (mainImg) {
      if (mainImg.complete) fitPhoto(false);
      let first = !mainImg.complete;
      mainImg.addEventListener('load', () => { fitPhoto(!first); first = false; });
    }
    // Gallery: thumbs, arrows, keyboard and swipe all go through show(). The first photo is the cover.
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0;
    const show = (i: number, dir: number) => {
      const n = thumbs.length;
      if (!mainImg || n < 2) return;
      i = (i + n) % n;
      if (i === cur) return;
      cur = i;
      mainImg.src = thumbs[i].dataset.thumb!;
      mainImg.animate(
        reduceMotion
          ? [{ opacity: 0.3 }, { opacity: 1 }]
          : [{ opacity: 0, transform: `translateX(${dir * 28}px)` }, { opacity: 1, transform: 'none' }],
        { duration: reduceMotion ? 200 : 360, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
      );
      thumbs.forEach((x, j) => x.setAttribute('aria-pressed', String(j === i)));
      const strip = thumbs[i].parentElement!;
      strip.scrollTo({ left: thumbs[i].offsetLeft - strip.clientWidth / 2 + thumbs[i].offsetWidth / 2, behavior: reduceMotion ? 'auto' : 'smooth' });
      if (countEl) countEl.textContent = String(i + 1);
      // Warm up the neighbours so the next step is instant.
      for (const k of [i + 1, i - 1]) new Image().src = thumbs[(k + n) % n].dataset.thumb!;
    };
    thumbs.forEach((b, j) => b.addEventListener('click', () => show(j, Math.sign(j - cur))));
    root.querySelectorAll<HTMLButtonElement>('[data-nav]').forEach((b) =>
      b.addEventListener('click', () => { const d = Number(b.dataset.nav); show(cur + d, d); }),
    );
    const media = root.querySelector<HTMLElement>('.media');
    media?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1, -1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1, 1); }
    });
    const frameEl = root.querySelector<HTMLElement>('.frame');
    if (frameEl && thumbs.length > 1) {
      let sx = 0, sy = 0, sid = -1;
      frameEl.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; sid = e.pointerId; });
      const end = (e: PointerEvent) => {
        if (e.pointerId !== sid) return;
        sid = -1;
        const dx = e.clientX - sx, dy = e.clientY - sy;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) show(cur - Math.sign(dx), -Math.sign(dx));
      };
      frameEl.addEventListener('pointerup', end);
      frameEl.addEventListener('pointercancel', () => { sid = -1; });
    }

    // Switch between "buy" and "ask when available". The block that appears skipped the scroll-reveal
    // while it was hidden, so it is marked as revealed straight away.
    const setStock = (state: 'in' | 'out') => {
      if (root.dataset.stock === state) return;
      root.dataset.stock = state;
      root.querySelectorAll(`[data-when="${state}"]`).forEach((el) => el.classList.add('is-in'));
    };
    // A sale can start, change or end after the site was built: redraw the prices from the live data.
    const untilEl = root.querySelector<HTMLElement>('[data-sale-until]');
    const applySale = (live: { sale?: { ends_at?: string; active?: boolean }; sizes: { id: number; price: number; sale_price?: number; sale_percent?: number }[] }) => {
      if (untilEl) {
        const txt = live.sale?.active ? saleEndText(live.sale.ends_at, root.dataset.lang || 'ka') : '';
        untilEl.textContent = txt;
        untilEl.hidden = !txt;
      }
      root.querySelectorAll<HTMLInputElement>('input[name="size"]').forEach((input) => {
        const s = live.sizes.find((x) => String(x.id) === input.value);
        if (!s) return;
        const now = s.sale_price ?? s.price;
        const on = now < s.price;
        input.dataset.price = String(now);
        input.dataset.old = on ? String(s.price) : '';
        input.dataset.pct = on ? String(s.sale_percent ?? '') : '';
        const pr = input.closest('label')?.querySelector('.pr');
        if (pr) pr.innerHTML = (on ? `<s class="was">₾ ${fmt(s.price)}</s><span class="sz-pct">−${s.sale_percent}%</span>` : '') + `<span data-pr>₾ ${fmt(now)}</span>`;
      });
      const sel = root.querySelector<HTMLInputElement>('input[name="size"]:checked');
      if (sel) apply(sel);
    };

    // Stock can change after the site was built: ask the API and switch the page if needed.
    fetch(`${root.dataset.api}/products/${root.dataset.slug}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((live) => {
        if (live && typeof live.in_stock === 'boolean') setStock(live.in_stock ? 'in' : 'out');
        if (live && Array.isArray(live.sizes)) applySale(live);
      })
      .catch(() => {});
    // The form reports a sale that happened while the visitor was on the page.
    form.addEventListener('lead:out-of-stock', () => setStock('out'));

    // Order drawer
    document.querySelector('[data-order-open]')?.addEventListener('click', () => { if (root.dataset.stock !== 'out') drawer.showModal(); });
    drawer.querySelector('[data-order-close]')?.addEventListener('click', () => drawer.close());
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.close();
    });
  }
</script>
