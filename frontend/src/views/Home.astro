---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Leaf from '../components/Leaf.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import { type Lang, useT, path } from '../i18n/ui';
import { loadData, loc, specimenNo, waLink, telLink, minPrice, priceFmt } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const { products, settings } = await loadData();

const heroProduct = products.find((p) => p.featured) ?? products[0];
const heroIndex = Math.max(0, products.indexOf(heroProduct));
const heroSize = heroProduct ? [...heroProduct.sizes].sort((a, b) => b.width - a.width)[0] : undefined;
// Each leaf is half of the panel width; clamp so the spread stays a composed figure.
const leafRatio = heroSize ? Math.min(0.9, Math.max(0.62, heroSize.width / 2 / heroSize.height)) : 0.75;

const pool = (products.filter((p) => p.featured).length >= 4 ? products.filter((p) => p.featured) : products).slice(0, 4);
// Tall slot first for a portrait design, wide slot for a landscape one.
const firstP = pool.find((p) => p.orientation === 'portrait');
const firstL = pool.find((p) => p.orientation === 'landscape');
const featured = [firstP, firstL, ...pool.filter((p) => p !== firstP && p !== firstL)].filter((p): p is NonNullable<typeof p> => !!p);
const spaces = ['restaurant', 'office', 'hotel', 'designer', 'home'] as const;
const types = (['portrait', 'landscape'] as const).map((key) => {
  const items = products.filter((p) => p.orientation === key);
  return { key, items, cover: items.find((p) => p.featured) ?? items[0], from: items.length ? Math.min(...items.map(minPrice)) : 0 };
}).filter((x) => x.cover);
---
<Base lang={lang}>
  <!-- Hero: centred statement, then the book-matched spread beneath it -->
  <section class="hero wrap">
    <div class="hero-copy center-stack">
      <h1 class="display t-4xl" data-reveal style="--d:2">{t('hero.title')}</h1>
      <p class="lead" data-reveal style="--d:4">{t('hero.lead')}</p>
      <div class="actions" data-reveal style="--d:6">
        <a class="btn btn-solid" href={path(lang, '/products/')}>{t('hero.cta.products')}<Icon name="arrow" /></a>
        <a class="btn btn-line" href={path(lang, '/contact/')}>{t('hero.cta.contact')}</a>
      </div>
    </div>

    {heroProduct && heroSize && (
      <figure class="hero-book">
        <div class="book-wrap">
          <a class="book" href={path(lang, `/products/${heroProduct.slug}/`)} aria-label={loc(heroProduct.name, lang)}>
            <div class="half l"><Leaf product={heroProduct} alt="" ratio={leafRatio} eager photo={false} /></div>
            <span class="spine" aria-hidden="true"></span>
            <div class="half r"><Leaf product={heroProduct} alt="" ratio={leafRatio} mirror eager photo={false} /></div>
          </a>
          <div class="hero-dim-h num" data-reveal style="--d:11"><span class="dim-v">{heroSize.height} {t('p.mm')}</span></div>
        </div>
        <div class="dim dim-ends hero-dim-w num" data-reveal style="--d:10"><span>{heroSize.width} {t('p.mm')}</span></div>
        <figcaption data-reveal style="--d:12">
          <span class="specimen-no">{specimenNo(heroIndex)}</span>
          <span class="cap-name">{loc(heroProduct.name, lang)}</span>
          <span class="cap-sep" aria-hidden="true"></span>
          <span class="cap-note"><em>{t('hero.caption')}.</em> {t('hero.captionNote')}</span>
        </figcaption>
      </figure>
    )}
  </section>

  <!-- Collection: the two product types -->
  <section class="section collection">
    <div class="wrap">
      <header class="center-stack sec-head">
        <h2 class="display t-3xl" data-reveal>{t('collection.title')}</h2>
        <p class="lead" data-reveal style="--d:1">{t('collection.lead')}</p>
        <a class="link-arrow" href={path(lang, '/products/')} data-reveal style="--d:2">{t('collection.all')} <Icon name="arrow" /></a>
      </header>

      <div class="types">
        {types.map((ty, i) => (
          <a class={`type type-${ty.key}`} href={`${path(lang, '/products/')}?type=${ty.key}`} data-reveal style={`--d:${i}`}>
            <div class="type-meta">
              <h3 class="display t-2xl">{t(`type.${ty.key}` as any)}</h3>
              <p>{t(`type.${ty.key}.d` as any)}</p>
              <span class="type-price num">{ty.items.length} {t('products.count')} · ₾ {priceFmt(ty.from)} {t('collection.from')}</span>
              <span class="type-go">{t('type.view')}<Icon name="arrow" size={18} /></span>
            </div>
            <div class="type-frame">
              <Leaf product={ty.cover!} alt="" ratio={ty.key === 'portrait' ? 0.68 : 1.5} photo />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured designs -->
  <section class="section featured">
    <div class="wrap">
      <header class="center-stack sec-head">
        <h2 class="display t-3xl" data-reveal>{t('collection.featured')}</h2>
      </header>
      <div class="spread">
        {featured.map((p, i) => (
          <SpecimenCard
            product={p}
            index={products.indexOf(p)}
            lang={lang}
            class={`s${i}`}
            ratio={p.orientation === 'portrait' ? (i === 0 ? 0.78 : 0.72) : i === 1 ? 1.5 : 1.15}
            d={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Spaces -->
  <section class="section spaces">
    <div class="wrap center-stack">
      <h2 class="display t-3xl" data-reveal>{t('spaces.title')}</h2>
      <ul class="spaces-list">
        {spaces.map((s, i) => (
          <li data-reveal style={`--d:${i}`}>{t(`spaces.${s}` as any)}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Close -->
  <section class="close wrap">
    <div class="close-panel center-stack">
      <h2 class="display t-3xl" data-reveal>{t('close.title')}</h2>
      <p class="lead" data-reveal style="--d:1">{t('close.lead')}</p>
      <div class="actions" data-reveal style="--d:2">
        {settings.whatsapp && (
          <a class="btn btn-solid" href={waLink(settings.whatsapp, t('p.waText'))} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
        )}
        {settings.phone && <a class="btn btn-line num" href={telLink(settings.phone)}><Icon name="phone" />{settings.phone}</a>}
      </div>
      <a class="link-arrow" href={path(lang, '/products/')} data-reveal style="--d:3">{t('close.products')} <Icon name="arrow" /></a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { display: grid; justify-items: center; gap: var(--s-5); padding-block: var(--s-5) var(--s-6); }
  .hero-copy h1 { max-width: 13ch; }
  :lang(ka) .hero-copy h1 { max-width: 16ch; font-size: clamp(2.4rem, 1rem + 4.2vw, 4.9rem); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }

  .hero-book { width: min(100%, 60rem); }
  .book-wrap { position: relative; padding-right: 2.25rem; }
  .book { display: grid; grid-template-columns: 1fr auto 1fr; text-decoration: none; filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.22)); }
  .half { overflow: hidden; }
  .spine { width: 2px; background: var(--gap); }
  .hero-dim-w { margin: 1rem 2.25rem 0 0; }
  .hero-dim-h::after { content: ''; position: absolute; left: 25%; right: 25%; top: 0; bottom: 0; border-block: 1px solid currentColor; opacity: 0.8; }
  .hero-dim-h { position: absolute; top: 0; bottom: 0; right: 0; width: 1rem; display: flex; justify-content: center; color: var(--ink-3); font-size: var(--t-xs); letter-spacing: 0.08em; }
  .hero-dim-h::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: currentColor; opacity: 0.55; }
  .hero-dim-h span { position: relative; align-self: center; background: var(--ground); padding-block: 0.5rem; }
  figcaption {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 0.4rem 0.9rem;
    margin-top: var(--s-3); padding-right: 2.25rem; color: var(--ink-2); font-size: var(--t-sm); text-align: center;
  }
  .cap-name { font-family: var(--f-display); font-size: var(--t-lg); color: var(--ink); }
  .cap-sep { width: 2rem; height: 1px; background: var(--line); align-self: center; }
  .cap-note em { font-family: var(--f-display); color: var(--ink); }

  /* Opening the book: the leaves unfold from the spine (first visit, once). */
  html.js .half :global(.leaf) { transition: clip-path 1500ms var(--ease-in-out), transform 1900ms var(--ease-out); }
  html.js .half.l :global(.leaf) { clip-path: inset(0 0 0 100%); transform: scale(1.06); transform-origin: right center; }
  html.js .half.r :global(.leaf) { clip-path: inset(0 100% 0 0); transform: scale(1.06); transform-origin: left center; }
  html.js .hero-book.open .half :global(.leaf) { clip-path: inset(0 0 0 0); transform: none; }
  html.js .spine { transform: scaleY(0); transition: transform 700ms var(--ease-out); }
  html.js .hero-book.open .spine { transform: none; }

  /* ---------- Section heads ---------- */
  .sec-head { margin-bottom: var(--s-5); }

  /* ---------- Collection: two type panels ---------- */
  .types { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .type {
    display: grid; grid-template-rows: auto 1fr; gap: var(--s-4); overflow: hidden;
    padding: clamp(2rem, 1rem + 3vw, 3.75rem) clamp(1.5rem, 1rem + 2.5vw, 3.5rem) 0;
    background: var(--ground-2); border-radius: 24px; text-decoration: none; color: inherit;
  }
  .type-meta { display: grid; justify-items: center; text-align: center; gap: 0.7rem; }
  .type-meta p { color: var(--ink-2); max-width: 34ch; text-wrap: pretty; }
  .type-price { font-size: var(--t-sm); color: var(--ink-3); }
  .type-go { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.3rem; color: var(--ink); font-weight: 600; font-size: var(--t-sm); }
  .type-go :global(svg) { transition: transform 240ms var(--ease-out); }
  .type-frame { display: flex; justify-content: center; align-items: flex-end; height: clamp(16rem, 30vw, 27rem); }
  .type-frame :global(.leaf) {
    height: 100%; width: auto; max-width: 100%; flex: none;
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.45); transition: transform 1100ms var(--ease-out); transform-origin: bottom center;
  }
  .type-meta h3 { font-size: var(--t-xl); overflow-wrap: anywhere; }
  .type { min-width: 0; }
  /* Landscape leaves fill the panel width; portrait leaves fill its height. */
  .type-landscape .type-frame :global(.leaf) { width: 100%; height: auto; }
  @media (hover: hover) and (pointer: fine) {
    .type:hover .type-frame :global(.leaf) { transform: scale(1.025); }
    .type:hover .type-go :global(svg) { transform: translateX(4px); }
  }

  /* ---------- Featured ---------- */
  .featured { padding-top: 0; }
  .spread {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: calc(var(--gutter) * 1.5); row-gap: var(--s-6);
    grid-template-areas:
      'a a a a a . b b b b b b'
      'a a a a a . c c c d d d';
  }
  .spread :global(.s0) { grid-area: a; }
  .spread :global(.s1) { grid-area: b; }
  .spread :global(.s2) { grid-area: c; }
  .spread :global(.s3) { grid-area: d; }

  /* ---------- Spaces ---------- */
  .spaces { border-top: 1px solid var(--line); }
  .spaces-list { list-style: none; padding: 0; display: grid; gap: 0.6rem; margin-top: var(--s-3); }
  .spaces-list li { font-family: var(--f-display); font-size: var(--t-2xl); line-height: 1.3; color: var(--ink-2); transition: color 300ms ease; }
  @media (hover: hover) and (pointer: fine) { .spaces-list li:hover { color: var(--ink); } }

  /* ---------- Close ---------- */
  .close { padding-bottom: var(--s-6); }
  .close-panel { padding: clamp(3.5rem, 2rem + 6vw, 7.5rem) clamp(1.5rem, 1rem + 4vw, 5rem); background: var(--ground-2); border-radius: 28px; }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .types { grid-template-columns: 1fr; }
    .spread { grid-template-areas: 'a a a a a a b b b b b b' 'c c c c c c d d d d d d'; row-gap: var(--s-5); }
  }
  @media (max-width: 620px) {
    .book-wrap { padding-right: 1.75rem; }
    .hero-dim-w { margin-right: 1.75rem; }
    figcaption { padding-right: 0; }
    .spread { grid-template-areas: 'a' 'b' 'c' 'd'; grid-template-columns: 1fr; row-gap: var(--s-5); }
    .actions .btn { flex: 1 1 auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .half :global(.leaf), html.js .spine { clip-path: none !important; transform: none !important; transition: none; }
  }
</style>

<script>
  // Open the book once the first paint is ready.
  const book = document.querySelector('.hero-book');
  if (book) requestAnimationFrame(() => setTimeout(() => book.classList.add('open'), 120));
</script>
