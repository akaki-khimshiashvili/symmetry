---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Leaf from '../components/Leaf.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import Hero from '../components/Hero.astro';
import { type Lang, useT, path } from '../i18n/ui';
import { loadData, waLink, telLink, minPrice, priceFmt } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const { products, settings } = await loadData();


const pool = (products.filter((p) => p.featured).length >= 4 ? products.filter((p) => p.featured) : products).slice(0, 4);
const featured = pool;
const types = (['portrait', 'landscape'] as const).map((key) => {
  const items = products.filter((p) => p.orientation === key);
  return { key, items, cover: items.find((p) => p.featured) ?? items[0], from: items.length ? Math.min(...items.map(minPrice)) : 0 };
}).filter((x) => x.cover);

---
<Base lang={lang} current="home">
  <Hero lang={lang} />

  <!-- Collection: pictures with text, on one even grid -->
  <section class="section collection">
    <div class="wrap">
      <h2 class="display t-3xl sec-title" data-reveal>{t('collection.title')}</h2>

      <div class="types">
        {types.map((ty, i) => (
          <a class={`tile tile-${ty.key}`} href={`${path(lang, '/products/')}?type=${ty.key}`} data-reveal style={`--d:${i};--r:${ty.key === 'portrait' ? 0.75 : 1.3333}`}>
            <div class="tile-img lift"><Leaf product={ty.cover!} alt="" ratio={ty.key === 'portrait' ? 3 / 4 : 4 / 3} photo /></div>
            <div class="tile-text">
              <h3>{t(`type.${ty.key}` as any)}</h3>
              <span class="num">{ty.items.length} {t('products.count')} · ₾ {priceFmt(ty.from)} {t('collection.from')}</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="display t-2xl sec-title sub" data-reveal>{t('collection.featured')}</h2>
      <div class="featured-grid">
        {featured.map((p, i) => (
          <div class="cell" style={`--r:${p.orientation === 'portrait' ? 0.75 : 1.3333}`}>
            <SpecimenCard product={p} index={products.indexOf(p)} lang={lang} ratio={p.orientation === 'portrait' ? 3 / 4 : 4 / 3} d={i} compact />
          </div>
        ))}
      </div>

      <div class="all" data-reveal>
        <a class="btn btn-line" href={path(lang, '/products/')}>{t('collection.all')}</a>
      </div>
    </div>
  </section>

  <!-- Close: a dark oak panel, type only. Big title on top; lead and actions split below a hairline. -->
  <section class="close wrap">
    <div class="close-panel">
      <p class="label close-eyebrow" data-reveal>{t('close.eyebrow')}</p>
      <h2 class="display close-title" data-reveal style="--d:1">{t('close.title')}</h2>
      <div class="close-foot">
        <p class="close-lead" data-reveal style="--d:2">{t('close.lead')}</p>
        <div class="close-cta" data-reveal style="--d:3">
          <div class="actions">
            {settings.whatsapp && (
              <a class="btn close-btn-main" href={waLink(settings.whatsapp, t('p.waText'))} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
            )}
            {settings.phone && <a class="btn close-btn-alt num" href={telLink(settings.phone)}><Icon name="phone" />{settings.phone}</a>}
          </div>
          <a class="close-link" href={path(lang, '/products/')}>{t('close.products')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Collection ---------- */
  .sec-title { text-align: center; margin-bottom: var(--s-5); }
  .sec-title.sub { margin-top: var(--s-6); }
  /* Justified rows: every picture in a row shares one height; widths follow each picture's shape.
     flex-grow and flex-basis are both proportional to the ratio, so the row fills the width evenly. */
  .types, .featured-grid { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; }
  .types { gap: var(--s-4) calc(var(--gutter) * 2); }
  .tile { flex: var(--r) 1 calc(var(--r) * 15rem); min-width: 0; display: grid; gap: 1.1rem; text-decoration: none; color: inherit; }
  .tile-img { overflow: hidden; }
  .tile-text { display: grid; gap: 0.3rem; }
  .tile-text h3 { font-size: var(--t-xl); font-weight: 500; letter-spacing: -0.01em; }
  .tile-text span { font-size: var(--t-sm); color: var(--ink-3); }
  .featured-grid { gap: var(--s-4) calc(var(--gutter) * 1.25); }
  .cell { flex: var(--r) 1 calc(var(--r) * 10rem); min-width: 0; }
  .all { display: flex; justify-content: center; margin-top: var(--s-5); }

  /* ---------- Close ---------- */
  .close { padding-bottom: var(--s-6); }
  .close-panel {
    display: grid; gap: clamp(1rem, 0.6rem + 1.4vw, 2rem);
    padding: clamp(2.25rem, 1rem + 5vw, 6rem) clamp(1.25rem, 0.5rem + 5vw, 6rem);
    background:
      radial-gradient(80% 120% at 100% 0%, color-mix(in oklab, var(--wood-hi) 14%, transparent), transparent 70%),
      var(--accent);
    color: var(--accent-ink);
    border-radius: clamp(16px, 1rem + 1vw, 28px);
  }
  .close-eyebrow { color: var(--wood-hi); }
  .close-title {
    font-size: clamp(2.1rem, 0.8rem + 5.4vw, 6.2rem); line-height: 1; letter-spacing: -0.035em;
    color: var(--accent-ink); max-width: 16ch;
  }
  :lang(ka) .close-title { font-size: clamp(1.7rem, 0.7rem + 4.2vw, 4.8rem); line-height: 1.12; letter-spacing: -0.015em; max-width: 18ch; }
  .close-foot {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    margin-top: clamp(1rem, 0.5rem + 2.5vw, 3rem); padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    border-top: 1px solid color-mix(in oklab, var(--accent-ink) 16%, transparent);
  }
  .close-lead {
    font-size: clamp(0.95rem, 0.88rem + 0.35vw, 1.2rem); line-height: 1.65; max-width: 42ch; text-wrap: pretty;
    color: color-mix(in oklab, var(--accent-ink) 74%, transparent);
  }
  .close-cta { display: grid; justify-items: end; gap: 1.1rem; }
  /* The group only fades; its buttons and link rise one after another (backwards fill keeps hover intact). */
  :global(html.js) .close-cta[data-reveal] { transform: none; filter: none; }
  :global(html.js) .close-cta:global(.is-in) :is(.actions > *, .close-link) { animation: rise-in 700ms var(--ease-out) backwards; animation-delay: 220ms; }
  :global(html.js) .close-cta:global(.is-in) .actions > :nth-child(2) { animation-delay: 310ms; }
  :global(html.js) .close-cta:global(.is-in) .close-link { animation-delay: 400ms; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .close-cta:global(.is-in) :is(.actions > *, .close-link) { animation: none; }
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.75rem; }
  .close-btn-main { background: var(--wood-hi); color: var(--accent); }
  .close-btn-alt { color: var(--accent-ink); border-color: color-mix(in oklab, var(--accent-ink) 30%, transparent); }
  .close-link {
    font-size: var(--t-sm); font-weight: 600; letter-spacing: 0.03em; text-decoration: none; color: var(--accent-ink);
    padding-block: 0.3rem; border-bottom: 1px solid color-mix(in oklab, var(--accent-ink) 28%, transparent);
    transition: border-color 240ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .close-btn-main:hover { background: var(--accent-ink); transform: translateY(-2px); }
    .close-btn-alt:hover { border-color: var(--accent-ink); background: color-mix(in oklab, var(--accent-ink) 8%, transparent); }
    .close-link:hover { border-color: var(--accent-ink); }
  }

  /* ---------- Responsive ---------- */
  /* Tablets: lead and actions stack, everything on one left edge. */
  @media (max-width: 960px) {
    .close-foot { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .close-cta { justify-items: start; }
    .actions { justify-content: flex-start; }
  }
  @media (max-width: 620px) {
    /* On phones each type sits on its own row; the tall one is kept narrower so it never towers. */
    /* Phones: both types full width on one left edge; the upright one is cropped to 4:5 so it doesn't tower. */
    .tile, .tile-portrait { flex: 1 1 100%; }
    .tile-portrait .tile-img :global(.leaf) { aspect-ratio: 4 / 5 !important; }
    .featured-grid { gap: var(--s-4) 0.9rem; }
    .cell { flex-basis: calc(var(--r) * 7rem); }
    .close-cta { width: 100%; justify-items: stretch; }
    .close-link { justify-self: start; }
    .actions { width: 100%; flex-direction: column; gap: 0.6rem; }
    .actions .btn { --h: 3rem; width: 100%; font-size: var(--t-xs); }
    .close-link { font-size: var(--t-xs); }
  }
</style>

