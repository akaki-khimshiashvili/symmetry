---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { type Lang, useT } from '../i18n/ui';
import { loadData, telLink, waLink } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const { settings: s } = await loadData();
const socials = [
  { key: 'instagram', href: s.instagram, label: 'Instagram' },
  { key: 'facebook', href: s.facebook, label: 'Facebook' },
  { key: 'tiktok', href: s.tiktok, label: 'TikTok' },
].filter((x) => x.href);
const address = lang === 'ka' ? s.address_ka : s.address_en;
const hours = lang === 'ka' ? s.hours_ka : s.hours_en;
---
<Base lang={lang} title={t('contact.title')} current="contact">
  <section class="wrap grid contact">
    <div class="side">
      <h1 class="display t-4xl" data-reveal>{t('contact.title')}</h1>
      <p class="lead" data-reveal style="--d:1">{t('contact.lead')}</p>

      <ul class="cards" data-reveal style="--d:2">
        {s.phone && (
          <li>
            <a class="card" href={telLink(s.phone)}>
              <span class="ic"><Icon name="phone" size={20} /></span>
              <span class="txt"><span class="k">{t('contact.phone')}</span><span class="v num">{s.phone}</span></span>
              <Icon name="arrow" size={18} class="go" />
            </a>
          </li>
        )}
        {s.whatsapp && (
          <li>
            <a class="card" href={waLink(s.whatsapp, '')} target="_blank" rel="noopener">
              <span class="ic"><Icon name="whatsapp" size={20} /></span>
              <span class="txt"><span class="k">WhatsApp</span><span class="v">{t('p.askWhatsapp')}</span></span>
              <Icon name="arrow" size={18} class="go" />
            </a>
          </li>
        )}
        {s.email && (
          <li>
            <a class="card" href={`mailto:${s.email}`}>
              <span class="ic"><Icon name="mail" size={20} /></span>
              <span class="txt"><span class="k">{t('contact.email')}</span><span class="v">{s.email}</span></span>
              <Icon name="arrow" size={18} class="go" />
            </a>
          </li>
        )}
      </ul>

      {(address || hours) && (
        <dl class="meta" data-reveal style="--d:3">
          {address && (
            <div><Icon name="pin" size={18} /><dt>{t('contact.location')}</dt><dd>{address}</dd></div>
          )}
          {hours && (
            <div><Icon name="clock" size={18} /><dt>{t('contact.hours')}</dt><dd class="num">{hours}</dd></div>
          )}
        </dl>
      )}

      {socials.length > 0 && (
        <div class="social" data-reveal style="--d:4">
          <p class="label">{t('contact.social')}</p>
          <ul>
            {socials.map((x) => (
              <li>
                <a class="soc" href={x.href} target="_blank" rel="noopener">
                  <Icon name={x.key} size={18} />
                  <span>{x.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="form-col" data-reveal style="--d:3">
      <LeadForm lang={lang} kind="contact" />
    </div>
  </section>
</Base>

<style>
  .contact { padding-block: var(--s-5) var(--s-6); row-gap: var(--s-5); column-gap: calc(var(--gutter) * 1.5); align-items: start; }
  .side { grid-column: 1 / span 5; display: grid; gap: var(--s-3); position: sticky; top: 7rem; }
  .form-col { grid-column: 7 / -1; padding: clamp(1.5rem, 3.5vw, 3.5rem); background: var(--ground-2); border-radius: 24px; }
  .form-col :global(.done) { background: var(--ground-2); }
  /* Direct lines: whole row is the link; icon tile, label over value, arrow nudges on hover. */
  .cards { display: grid; gap: 0.5rem; margin: var(--s-2) 0 0; padding: 0; list-style: none; }
  .card {
    display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1rem 0.85rem 0.85rem;
    border: 1px solid var(--line); border-radius: 14px; text-decoration: none; color: var(--ink);
    background: color-mix(in oklab, var(--ground) 55%, white);
    transition: border-color 150ms ease, background-color 150ms ease, transform 160ms var(--ease-out);
  }
  .ic {
    display: inline-grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 10px;
    background: var(--ground-2); color: var(--accent); transition: background-color 150ms ease, color 150ms ease;
  }
  .txt { display: grid; gap: 0.1rem; min-width: 0; }
  .k { font-size: var(--t-xs); color: var(--ink-3); }
  .v { font-size: var(--t-base); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card :global(.go) { margin-left: auto; flex: none; color: var(--ink-3); transition: translate 200ms var(--ease-out), color 150ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .card:hover { border-color: color-mix(in oklab, var(--ink) 24%, transparent); }
    .card:hover .ic { background: var(--accent); color: var(--accent-ink); }
    .card:hover :global(.go) { translate: 3px 0; color: var(--ink); }
  }
  .card:active { transform: scale(0.98); }

  /* Location and hours: quiet info, not links. */
  .meta { display: grid; gap: 0.9rem; margin: var(--s-1) 0 0; padding: var(--s-3) 0 0; border-top: 1px solid var(--line); }
  .meta div { display: grid; grid-template-columns: auto 7.5rem 1fr; align-items: start; gap: 0.75rem; font-size: var(--t-sm); }
  .meta :global(.icon) { color: var(--ink-3); margin-top: 1px; }
  .meta dt { color: var(--ink-3); }
  .meta dd { margin: 0; color: var(--ink); }

  /* Socials: outlined pills, filled with oak on hover. */
  .social { display: grid; gap: 0.75rem; padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .social .label { margin: 0; color: var(--ink-3); }
  .social ul { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .soc {
    display: inline-flex; align-items: center; gap: 0.5rem; height: 2.6rem; padding: 0 1.1rem 0 0.9rem;
    border: 1px solid var(--line); border-radius: 999px; text-decoration: none;
    font-size: var(--t-sm); font-weight: 500; color: var(--ink-2);
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 160ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .soc:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  }
  .soc:active { transform: scale(0.97); }

  @media (max-width: 960px) {
    .side, .form-col { grid-column: 1 / -1; position: static; }
  }
  @media (max-width: 480px) {
    .meta div { grid-template-columns: auto 1fr; }
    .meta dd { grid-column: 2; }
  }
</style>
