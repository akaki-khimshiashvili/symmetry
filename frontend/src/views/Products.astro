<script>
  const shop = document.querySelector<HTMLElement>('[data-shop]');
  const cat = shop?.querySelector<HTMLElement>('[data-cat]');
  if (shop && cat) {
    type Group = 'type' | 'dim' | 'mat' | 'size';
    const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = shop) => root.querySelector<T>(s);
    const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = shop) => [...root.querySelectorAll<T>(s)];
    const lang = shop.dataset.lang || 'ka';
    const text = JSON.parse(shop.dataset.text || '{}');
    const LO = Number(shop.dataset.lo), HI = Number(shop.dataset.hi);
    const sheet = $<HTMLDialogElement>('[data-sheet]')!;
    const sortBtn = $<HTMLButtonElement>('[data-pill="sort"]')!;
    const sortPop = $<HTMLElement>('#fp-sort')!;
    const sortOpts = $$<HTMLElement>('[data-sort-list] [data-sort]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const gel = (n: number) => `₾ ${new Intl.NumberFormat('en-US').format(n).replace(/,/g, ' ')}`;

    const cells = $$<HTMLElement>('.cell', cat).map((el) => ({
      el,
      type: el.dataset.type!, dim: el.dataset.dim!, mat: el.dataset.mat!, sizes: (el.dataset.sizes || '').split(' '),
      pmin: Number(el.dataset.pmin), pmax: Number(el.dataset.pmax), stock: el.dataset.stock === '1', sale: el.dataset.sale === '1',
