---
import Base from '../layouts/Base.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import { type Lang, useT } from '../i18n/ui';
import { loadData } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const { products } = await loadData();
---
<Base lang={lang} title={t('products.title')} current="products">
  <section class="wrap intro center-stack">
    <h1 class="display t-4xl" data-reveal>{t('products.title')}</h1>
    <p class="lead" data-reveal style="--d:1">{t('products.lead')}</p>
    <div class="filter" role="group" aria-label={t('type.filter')} data-filter>
      {(['all', 'portrait', 'landscape'] as const).map((k) => {
        const n = k === 'all' ? products.length : products.filter((p) => p.orientation === k).length;
        return (
          <button type="button" data-f={k} aria-pressed={k === 'all' ? 'true' : 'false'}>
            <span class="notch" aria-hidden="true"></span>
            {k === 'all' ? t('type.all') : t(`type.${k}` as any)}
            <span class="n num">{n}</span>
          </button>
        );
      })}
    </div>
  </section>

  <section class="wrap catalogue">
    {products.length === 0 ? (
      <p class="empty lead">{t('products.empty')}</p>
    ) : (
      <div class="cat" data-cat>
        {products.map((p, i) => {
          const r = p.orientation === 'portrait' ? 0.75 : 1.3333;
          return (
            <div class="cell" data-type={p.orientation} style={`--r:${r}`}>
              <SpecimenCard product={p} index={i} lang={lang} ratio={r} d={i % 3} heading="h2" />
            </div>
          );
        })}
      </div>
    )}
  </section>
</Base>

<style>
  .intro { padding-block: var(--s-5) var(--s-6); }
  .filter { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: var(--s-2); }
  .filter button {
    display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1.1rem; cursor: pointer;
    background: none; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-2); font-size: var(--t-sm);
    transition: border-color 200ms ease, color 200ms ease, transform 160ms var(--ease-out);
  }
  .filter button:active { transform: scale(0.97); }
  .filter .notch { width: 0.5rem; height: 0.5rem; border: 1px solid var(--ink-3); transform: rotate(45deg); transition: background-color 200ms ease, border-color 200ms ease; }
  .filter .n { color: var(--ink-3); font-size: var(--t-xs); }
  .filter button[aria-pressed='true'] { color: var(--ink); border-color: var(--ink-2); }
  .filter button[aria-pressed='true'] .notch { background: var(--accent); border-color: var(--accent); }
  @media (hover: hover) and (pointer: fine) { .filter button:hover { color: var(--ink); border-color: var(--ink-3); } }
  .catalogue { padding-bottom: var(--s-6); }
  /* Justified rows: every picture in a row shares one height and its width follows its shape
     (flex-grow and flex-basis ∝ aspect ratio). max-width ∝ ratio too, so a short last row keeps
     the same height instead of ballooning. Rows are centred. */
  .cat { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: var(--s-5) calc(var(--gutter) * 1.5); }
  .cell { flex: var(--r) 1 calc(var(--r) * 15rem); max-width: calc(var(--r) * 26rem); min-width: 0; }
  .cell[hidden] { display: none; }
  /* Wider screens: one shared picture height for the whole catalogue; widths follow each shape. */
  @media (min-width: 621px) {
    .cat { --h: clamp(12rem, 17vw, 18rem); }
    .cell { flex: 0 0 calc(var(--r) * var(--h)); max-width: none; }
  }
  .empty { padding-block: var(--s-6); }
  @media (max-width: 620px) {
    .cat { gap: var(--s-4) 0.9rem; }
    .cell { flex-basis: calc(var(--r) * 7.5rem); max-width: calc(var(--r) * 15rem); }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter]');
  const cat = document.querySelector<HTMLElement>('[data-cat]');
  if (bar && cat) {
    const cells = [...cat.querySelectorAll<HTMLElement>('.cell')];
    const apply = (f: string) => {
      bar.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
      for (const c of cells) {
        c.hidden = !(f === 'all' || c.dataset.type === f);
        c.querySelector('.spec')?.classList.add('is-in');
      }
      const url = new URL(location.href);
      if (f === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', f);
      history.replaceState(null, '', url);
    };
    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-f]');
      if (b) apply(b.dataset.f!);
    });
    const initial = new URLSearchParams(location.search).get('type');
    if (initial === 'portrait' || initial === 'landscape') apply(initial);
  }
</script>
