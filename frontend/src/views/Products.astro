---
import Base from '../layouts/Base.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import Icon from '../components/Icon.astro';
import { type Lang, useT } from '../i18n/ui';
import { loadData, kindOf, dimensionOf, loc, nowPrice, onSale, priceFmt, type Product } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const { products } = await loadData();

/* ---------- Everything a filter can match on, worked out once at build time ---------- */
const matKey = (p: Product) => (p.material.ka || p.material.en || '').trim();
/** Size buckets by a size's longest side: up to 60 cm, 61–120 cm, over 120 cm. */
const bucket = (w: number, h: number) => { const m = Math.max(w, h); return m <= 60 ? 's' : m <= 120 ? 'm' : 'l'; };
const facts = products.map((p, i) => {
  const prices = p.sizes.map(nowPrice);
  return {
    p, i,
    type: kindOf(p),
    dim: dimensionOf(p),
    mat: matKey(p),
    sizes: [...new Set(p.sizes.map((s) => bucket(s.width, s.height)))],
    pmin: prices.length ? Math.min(...prices) : 0,
    pmax: prices.length ? Math.max(...prices) : 0,
    stock: p.in_stock !== false,
    sale: onSale(p),
    disc: onSale(p) ? p.sale!.percent : 0,
  };
});

const TYPES = (['portrait', 'landscape', 'shelf', 'wall'] as const).filter((k) => facts.some((f) => f.type === k));
const STEP = 50;
const priceLo = facts.length ? Math.floor(Math.min(...facts.map((f) => f.pmin)) / STEP) * STEP : 0;
const priceHi = facts.length ? Math.ceil(Math.max(...facts.map((f) => f.pmax)) / STEP) * STEP : STEP;
const anySale = facts.some((f) => f.sale);
const anyOut = facts.some((f) => !f.stock);

/** The option groups. A group only appears when it can actually split the catalogue (two or more values). */
type Opt = { value: string; label: string; hint?: string };
const groups: { key: 'type' | 'dim' | 'mat' | 'size'; label: string; note?: string; options: Opt[] }[] = [
  {
    key: 'type', label: t('f.type'),
    options: TYPES.map((k) => ({ value: k, label: t(`type.${k}` as any) })),
  },
  {
    key: 'dim', label: t('f.dimension'),
    options: (['portrait', 'landscape', 'wall'] as const).filter((k) => facts.some((f) => f.dim === k)).map((k) => ({ value: k, label: t(`dim.${k}` as any) })),
  },
  {
    key: 'mat', label: t('f.material'),
    options: [...new Map(facts.filter((f) => f.mat).map((f) => [f.mat, loc(f.p.material, lang)])).entries()]
      .sort((a, b) => a[1].localeCompare(b[1], lang)).map(([value, label]) => ({ value, label })),
  },
  {
    key: 'size', label: t('f.size'), note: t('f.size.note'),
    options: (['s', 'm', 'l'] as const).filter((k) => facts.some((f) => f.sizes.includes(k)))
      .map((k) => ({ value: k, label: t(`f.size.${k}` as any), hint: t(`f.size.${k}.d` as any) })),
  },
].filter((g) => g.options.length > 1) as any;
const hasPrice = priceHi > priceLo;
/** Phone sheet order: price comes right after the shape choices, above material and size. */
const sheetSeq: ((typeof groups)[number] | 'price')[] = [
  ...groups.filter((g) => g.key === 'type' || g.key === 'dim'),
  ...(hasPrice ? (['price'] as const) : []),
  ...groups.filter((g) => g.key === 'mat' || g.key === 'size'),
];

const SORTS = ['rec', 'priceAsc', 'priceDesc', 'newest', 'discount', 'name'] as const;
const text = {
  results: t('f.results'), results1: t('f.results1'), show: t('f.show'), remove: t('f.remove'),
  type: t('f.type'), dim: t('f.dimension'), mat: t('f.material'), size: t('f.size'), price: t('f.price'),
  stock: t('f.inStock'), sale: t('f.onSale'),
  labels: {
    type: Object.fromEntries(TYPES.map((k) => [k, t(`type.${k}` as any)])),
    ...Object.fromEntries(groups.map((g) => [g.key, Object.fromEntries(g.options.map((o) => [o.value, o.label]))])),
  },
};
---
<Base lang={lang} title={t('products.title')} current="products">
  <section class="wrap intro center-stack">
    <h1 class="display t-4xl" data-reveal>{t('products.title')}</h1>
    <p class="lead" data-reveal style="--d:1">{t('products.lead')}</p>
  </section>

  <section class="wrap catalogue" data-shop data-lang={lang} data-lo={priceLo} data-hi={priceHi} data-text={JSON.stringify(text)}>
    {products.length === 0 ? (
      <p class="empty lead">{t('products.empty')}</p>
    ) : (
      <>
        {/* ---------- One bar: filter pills, toggles, sort ---------- */}
        <div class="bar" data-bar>
          <button class="f-open" type="button" data-f-open aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
            <span>{t('f.filters')}</span>
            <span class="badge num" data-badge hidden></span>
          </button>

          <div class="pills" role="group" aria-label={t('f.filters')}>
            {groups.map((g) => (
              <div class="pill-wrap">
                <button class="pill" type="button" popovertarget={`fp-${g.key}`} data-pill={g.key} aria-expanded="false">
                  <span class="pill-k">{g.label}</span>
                  <span class="pill-v num" data-pill-v hidden></span>
                  <Icon name="chevron" size={14} />
                </button>
                <div class="pop" id={`fp-${g.key}`} popover data-pop={g.key}>
                  <fieldset class:list={['grp', { cols: g.options.length > 6 }]} data-ctl>
                    <legend class="sr">{g.label}</legend>
                    {g.note && <p class="pop-note">{g.note}</p>}
                    <div class="opts">
                      {g.options.map((o) => (
                        <label class="opt"><input type="checkbox" name={g.key} value={o.value} /><span class="box" aria-hidden="true"></span><span class="opt-t">{o.label}{o.hint && <small>{o.hint}</small>}</span><span class="opt-n num" data-n></span></label>
                      ))}
                    </div>
                  </fieldset>
                  <div class="pop-foot">
                    <button class="link" type="button" data-clear={g.key}>{t('f.resetShort')}</button>
                    <span class="num" data-live></span>
                  </div>
                </div>
              </div>
            ))}
            {hasPrice && (
              <div class="pill-wrap">
                <button class="pill" type="button" popovertarget="fp-price" data-pill="price" aria-expanded="false">
                  <span class="pill-k">{t('f.price')}</span>
                  <span class="pill-v num" data-pill-v hidden></span>
                  <Icon name="chevron" size={14} />
                </button>
                <div class="pop pop-price" id="fp-price" popover data-pop="price">
                  <div class="price" data-ctl>
                    <p class="price-out num"><span data-plo>₾ {priceFmt(priceLo)}</span><span aria-hidden="true">—</span><span data-phi>₾ {priceFmt(priceHi)}</span></p>
                    <div class="range" data-range>
                      <input type="range" name="pmin" min={priceLo} max={priceHi} step={STEP} value={priceLo} aria-label={t('f.priceMin')} />
                      <input type="range" name="pmax" min={priceLo} max={priceHi} step={STEP} value={priceHi} aria-label={t('f.priceMax')} />
                    </div>
                    <p class="range-ends num" aria-hidden="true"><span>₾ {priceFmt(priceLo)}</span><span>₾ {priceFmt(priceHi)}</span></p>
                  </div>
                  <div class="pop-foot">
                    <button class="link" type="button" data-clear="price">{t('f.resetShort')}</button>
                    <span class="num" data-live></span>
                  </div>
                </div>
              </div>
            )}
            {anyOut && <label class="pill toggle" data-ctl><input type="checkbox" name="stock" value="1" /><span class="notch" aria-hidden="true"></span>{t('f.inStockShort')}</label>}
            {anySale && <label class="pill toggle" data-ctl><input type="checkbox" name="sale" value="1" /><span class="notch" aria-hidden="true"></span>{t('f.onSaleShort')}</label>}
          </div>

          <div class="sort">
            <button class="pill sort-btn" type="button" popovertarget="fp-sort" data-pill="sort" aria-haspopup="listbox" aria-expanded="false">
              <svg class="sort-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/></svg>
              <span class="sr">{t('f.sort')}: </span>
              <span class="sort-v" data-sort-label>{t('f.sort.rec')}</span>
              <Icon name="chevron" size={14} />
            </button>
            <div class="pop pop-sort" id="fp-sort" popover data-pop="sort" data-align="end">
              <p class="pop-title" id="fp-sort-t">{t('f.sort')}</p>
              <ul class="sort-list" role="listbox" aria-labelledby="fp-sort-t" data-sort-list>
                {SORTS.map((k) => (k === 'discount' && !anySale ? null : (
                  <li role="option" tabindex="-1" data-sort={k} aria-selected={k === 'rec' ? 'true' : 'false'}>
                    <span class="notch" aria-hidden="true"></span>{t(`f.sort.${k}` as any)}
                  </li>
                )))}
              </ul>
            </div>
          </div>
        </div>

        {/* ---------- Status: count, what is applied, reset ---------- */}
        <div class="status">
          <p class="count num" aria-live="polite" data-count></p>
          <div class="active" data-active hidden>
            <span class="sr">{t('f.active')}</span>
            <ul data-chips></ul>
          </div>
          <button class="link reset" type="button" data-reset>{t('f.reset')}</button>
        </div>

        <div class="cat" data-cat>
          {facts.map((f) => {
            const r = f.p.orientation === 'portrait' ? 0.75 : 1.3333;
            return (
              <div class="cell" style={`--r:${r}`}
                data-type={f.type} data-dim={f.dim} data-mat={f.mat} data-sizes={f.sizes.join(' ')}
                data-pmin={f.pmin} data-pmax={f.pmax} data-stock={f.stock ? '1' : '0'} data-sale={f.sale ? '1' : '0'}
                data-disc={f.disc} data-id={f.p.id} data-order={f.i} data-name={loc(f.p.name, lang)}>
                <SpecimenCard product={f.p} index={f.i} lang={lang} ratio={r} d={f.i % 3} heading="h2" />
              </div>
            );
          })}
        </div>
        <div class="none" data-none hidden>
          <p class="none-t">{t('f.none')}</p>
          <p class="none-d">{t('f.noneHint')}</p>
          <button class="btn btn-solid" type="button" data-reset><span>{t('f.reset')}</span></button>
        </div>

        {/* ---------- Phones: the same filters, stacked in a sheet ---------- */}
        <dialog class="sheet" data-sheet aria-labelledby="f-title">
          <div class="sh-head">
            <h2 id="f-title" class="sh-title">{t('f.filters')}</h2>
            <button class="x" type="button" data-sheet-close aria-label={t('nav.close')}><Icon name="close" size={22} /></button>
          </div>
          <div class="sh-body">
            {sheetSeq.map((g) => (g === 'price' ? (
              <fieldset class="grp" data-ctl>
                <legend>{t('f.price')}</legend>
                <div class="price">
                  <p class="price-out num"><span data-plo>₾ {priceFmt(priceLo)}</span><span aria-hidden="true">—</span><span data-phi>₾ {priceFmt(priceHi)}</span></p>
                  <div class="range" data-range>
                    <input type="range" name="pmin" min={priceLo} max={priceHi} step={STEP} value={priceLo} aria-label={t('f.priceMin')} />
                    <input type="range" name="pmax" min={priceLo} max={priceHi} step={STEP} value={priceHi} aria-label={t('f.priceMax')} />
                  </div>
                  <p class="range-ends num" aria-hidden="true"><span>₾ {priceFmt(priceLo)}</span><span>₾ {priceFmt(priceHi)}</span></p>
                </div>
              </fieldset>
            ) : (
              <fieldset class="grp" data-ctl>
                <legend>{g.label}{g.note && <span class="legend-note">{g.note}</span>}</legend>
                <div class="opts">
                  {g.options.map((o) => (
                    <label class="opt"><input type="checkbox" name={g.key} value={o.value} /><span class="box" aria-hidden="true"></span><span class="opt-t">{o.label}{o.hint && <small>{o.hint}</small>}</span><span class="opt-n num" data-n></span></label>
                  ))}
                </div>
              </fieldset>
            )))}
            {(anyOut || anySale) && (
              <fieldset class="grp" data-ctl>
                <legend>{t('f.avail')}</legend>
                {anyOut && <label class="sw"><input type="checkbox" name="stock" value="1" /><span class="track" aria-hidden="true"></span><span>{t('f.inStock')}</span></label>}
                {anySale && <label class="sw"><input type="checkbox" name="sale" value="1" /><span class="track" aria-hidden="true"></span><span>{t('f.onSale')}</span></label>}
              </fieldset>
            )}
          </div>
          <div class="sh-foot">
            <button class="btn btn-line" type="button" data-reset><span>{t('f.resetShort')}</span></button>
            <button class="btn btn-solid" type="button" data-sheet-done><span data-show></span></button>
          </div>
        </dialog>
      </>
    )}
  </section>
</Base>

<style>
  .intro { padding-block: var(--s-5) var(--s-3); grid-template-columns: minmax(0, 1fr); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  [hidden] { display: none !important; }

  .notch { flex: none; width: 0.5rem; height: 0.5rem; border: 1px solid var(--ink-3); transform: rotate(45deg); transition: background-color 200ms ease, border-color 200ms ease; }

  .catalogue { padding-bottom: var(--s-6); }

  /* ---------- The bar: pinned under the header, between two hairlines ---------- */
  .bar {
    position: sticky; top: var(--header-h); z-index: 20;
    display: flex; align-items: flex-start; gap: 0.75rem;
    margin-inline: calc(-1 * var(--margin)); padding: 0.7rem var(--margin);
    background: color-mix(in oklab, var(--ground) 94%, transparent);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-block: 1px solid var(--line);
  }
  .pills { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; min-width: 0; flex: 1; }
  .pill-wrap { display: contents; }
  .pill {
    position: relative; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 0.95rem 0 1.05rem; cursor: pointer;
    background: none; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; font: inherit; font-size: var(--t-sm); white-space: nowrap;
    transition: border-color 200ms ease, background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .pill:active { transform: scale(0.97); }
  .pill :global(svg) { color: var(--ink-3); transition: transform 240ms var(--ease-out); }
  .pill[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .pill-k { color: var(--ink-2); }
  /* Applied: the pill fills with oak paper and states its value. */
  .pill.is-on { background: var(--ground-2); border-color: var(--ink-2); }
  .pill.is-on .pill-k { color: var(--ink); }
  .pill-v { font-weight: 600; max-width: 9rem; overflow: hidden; text-overflow: ellipsis; }
  .pill[aria-expanded='true'] { border-color: var(--ink-2); }
  @media (hover: hover) and (pointer: fine) { .pill:hover { border-color: var(--ink-3); } .pill.is-on:hover, .pill[aria-expanded='true']:hover { border-color: var(--ink); } }
  /* Toggles: the same notch as the type chips. */
  .toggle { gap: 0.6rem; padding-inline: 1rem; color: var(--ink-2); }
  .toggle input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .toggle:has(input:checked) { color: var(--ink); background: var(--ground-2); border-color: var(--ink-2); }
  .toggle:has(input:checked) .notch { background: var(--accent); border-color: var(--accent); }
  .toggle:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  .sort { flex: none; margin-left: auto; }
  .pill:focus-visible, .f-open:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sort-btn { font-weight: 600; }
  .sort-btn .sort-ico { color: var(--ink-3); }
  .sort-v { min-width: 0; overflow: hidden; text-overflow: ellipsis; }

  /* Sort list: one choice, marked with the same notch as every other selection. */
  .pop-sort { min-width: 17rem; padding-block: 0.4rem; }
  .pop-title { padding: 0.55rem 1.15rem 0.35rem; font-size: var(--t-xs); color: var(--ink-3); }
  .sort-list { list-style: none; margin: 0; padding: 0 0.4rem; display: grid; }
  .sort-list li {
    display: flex; align-items: center; gap: 0.75rem; min-height: 2.75rem; padding: 0 0.75rem; border-radius: 8px; cursor: pointer;
    font-size: var(--t-sm); color: var(--ink-2); outline: none; transition: background-color 140ms ease, color 140ms ease;
  }
  .sort-list li[aria-selected='true'] { color: var(--ink); font-weight: 600; }
  .sort-list li[aria-selected='true'] .notch { background: var(--accent); border-color: var(--accent); }
  .sort-list li:focus-visible { background: var(--ground-2); color: var(--ink); box-shadow: inset 0 0 0 2px var(--accent); }
  @media (hover: hover) and (pointer: fine) { .sort-list li:hover { background: var(--ground-2); color: var(--ink); } }

  .f-open {
    display: none; align-items: center; justify-content: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 1.05rem; cursor: pointer;
    background: none; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; font: inherit; font-size: var(--t-sm); font-weight: 600;
    transition: transform 160ms var(--ease-out), border-color 200ms ease;
  }
  .f-open:active { transform: scale(0.97); }
  .badge { min-width: 1.35rem; height: 1.35rem; padding: 0 0.35rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-size: var(--t-xs); display: inline-grid; place-items: center; }

  /* ---------- Popovers: drop from their pill, sized to their content, never scroll ---------- */
  .pop {
    position: fixed; inset: auto; margin: 0; padding: 0; width: max-content; min-width: 15rem; max-width: min(36rem, calc(100vw - 2rem));
    background: var(--ground); color: var(--ink); border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 1px 2px rgb(30 15 5 / 0.08), 0 24px 48px -20px rgb(40 22 10 / 0.35);
    transform-origin: var(--origin, top left);
    opacity: 1; transform: none;
    transition: opacity 180ms var(--ease-out), transform 220ms var(--ease-out), overlay 220ms allow-discrete, display 220ms allow-discrete;
  }
  .pop:not(:popover-open) { opacity: 0; transform: translateY(-4px) scale(0.98); }
  @starting-style { .pop:popover-open { opacity: 0; transform: translateY(-4px) scale(0.98); } }
  .pop .grp, .pop .price { padding: 1rem 1.15rem 0.75rem; }
  .pop-note { font-size: var(--t-xs); color: var(--ink-3); margin-bottom: 0.4rem; }
  .pop .cols .opts { display: grid; grid-template-columns: repeat(2, minmax(12rem, 1fr)); column-gap: 1.5rem; }
  .pop-price { width: 21rem; }
  .pop-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.55rem 1.15rem; border-top: 1px solid var(--line); font-size: var(--t-xs); color: var(--ink-3); }

  /* ---------- Options ---------- */
  .grp { border: 0; margin: 0; padding: 0; min-width: 0; }
  .opt { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.75rem; min-height: 2.75rem; cursor: pointer; font-size: var(--t-sm); color: var(--ink-2); transition: color 160ms ease, opacity 200ms ease; }
  .opt input, .sw input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .box { width: 1.15rem; height: 1.15rem; border: 1px solid var(--ink-3); border-radius: 3px; display: grid; place-items: center; transition: background-color 160ms ease, border-color 160ms ease; }
  .box::after { content: ''; width: 0.4rem; height: 0.4rem; transform: rotate(45deg) scale(0.4); background: var(--accent-ink); opacity: 0; transition: transform 200ms var(--ease-out), opacity 160ms ease; }
  .opt input:checked ~ .box { background: var(--accent); border-color: var(--accent); }
  .opt input:checked ~ .box::after { opacity: 1; transform: rotate(45deg) scale(1); }
  .opt input:checked ~ .opt-t { color: var(--ink); font-weight: 600; }
  .opt input:focus-visible ~ .box, .sw input:focus-visible ~ .track { outline: 2px solid var(--accent); outline-offset: 2px; }
  .opt-t small { display: block; font-size: var(--t-xs); color: var(--ink-3); font-weight: 400; }
  .opt-n { font-size: var(--t-xs); color: var(--ink-3); }
  .opt.is-empty { opacity: 0.4; cursor: default; }
  @media (hover: hover) and (pointer: fine) { .opt:not(.is-empty):hover { color: var(--ink); } .opt:not(.is-empty):hover .box { border-color: var(--ink-2); } }

  /* Price: two native ranges over one track; the filled part sits between the handles. */
  .price-out { display: flex; gap: 0.6rem; font-weight: 600; font-size: var(--t-base); color: var(--ink); }
  .range { position: relative; height: 2.75rem; }
  .range::before, .range::after { content: ''; position: absolute; top: 50%; height: 4px; margin-top: -2px; border-radius: 4px; pointer-events: none; }
  .range::before { left: 0; right: 0; background: var(--line); }
  .range::after { left: var(--lo, 0%); right: calc(100% - var(--hi, 100%)); background: var(--accent); }
  .range input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; background: none; appearance: none; -webkit-appearance: none; pointer-events: none; z-index: 1; }
  .range input::-webkit-slider-runnable-track { background: none; height: 100%; }
  .range input::-moz-range-track { background: none; }
  .range input::-webkit-slider-thumb {
    -webkit-appearance: none; pointer-events: auto; width: 1.5rem; height: 1.5rem; margin-top: calc((2.75rem - 1.5rem) / 2); border-radius: 50%; cursor: grab;
    background: var(--ground); border: 2px solid var(--accent); box-shadow: 0 2px 6px -2px rgb(30 15 5 / 0.4); transition: transform 160ms var(--ease-out);
  }
  .range input::-moz-range-thumb { pointer-events: auto; width: 1.25rem; height: 1.25rem; border-radius: 50%; cursor: grab; background: var(--ground); border: 2px solid var(--accent); box-shadow: 0 2px 6px -2px rgb(30 15 5 / 0.4); }
