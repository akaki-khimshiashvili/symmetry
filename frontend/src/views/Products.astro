    /* ---------- State (mirrors the URL) ---------- */
    const state = { type: new Set<string>(), dim: new Set<string>(), mat: new Set<string>(), size: new Set<string>(), lo: LO, hi: HI, stock: false, sale: false, sort: 'rec' };
    const read = () => {
      const q = new URLSearchParams(location.search);
      const list = (k: string) => new Set((q.get(k) || '').split(',').filter(Boolean));
      state.type = list('type');
      state.dim = list('dim'); state.mat = list('mat'); state.size = list('size');
      state.lo = Math.max(LO, Math.min(HI, Number(q.get('pmin')) || LO));
      state.hi = Math.max(state.lo, Math.min(HI, Number(q.get('pmax')) || HI));
      state.stock = q.get('stock') === '1'; state.sale = q.get('sale') === '1';
      state.sort = sortOpts.some((o) => o.dataset.sort === q.get('sort')) ? q.get('sort')! : 'rec';
    };
    const write = () => {
      const url = new URL(location.href);
      const q = url.searchParams;
      const set = (k: string, v: string | null) => (v ? q.set(k, v) : q.delete(k));
      set('type', [...state.type].join(',') || null);
      set('dim', [...state.dim].join(',') || null); set('mat', [...state.mat].join(',') || null); set('size', [...state.size].join(',') || null);
      set('pmin', state.lo > LO ? String(state.lo) : null); set('pmax', state.hi < HI ? String(state.hi) : null);
      set('stock', state.stock ? '1' : null); set('sale', state.sale ? '1' : null); set('sort', state.sort !== 'rec' ? state.sort : null);
      history.replaceState(null, '', url);
    };
    const priceOn = () => state.lo > LO || state.hi < HI;
    const activeCount = () =>
      state.type.size + state.dim.size + state.mat.size + state.size.size + (priceOn() ? 1 : 0) + (state.stock ? 1 : 0) + (state.sale ? 1 : 0);

    /* ---------- Matching (skip one group to count its options faceted) ---------- */
    const matches = (c: Cell, skip?: string) =>
      (skip === 'type' || !state.type.size || state.type.has(c.type)) &&
      (skip === 'dim' || !state.dim.size || state.dim.has(c.dim)) &&
      (skip === 'mat' || !state.mat.size || state.mat.has(c.mat)) &&
      (skip === 'size' || !state.size.size || c.sizes.some((s) => state.size.has(s))) &&
      (c.pmax >= state.lo && c.pmin <= state.hi) &&
      (!state.stock || c.stock) && (!state.sale || c.sale);

    const sorters: Record<string, (a: Cell, b: Cell) => number> = {
      rec: (a, b) => a.order - b.order,
      priceAsc: (a, b) => a.pmin - b.pmin || a.order - b.order,
      priceDesc: (a, b) => b.pmin - a.pmin || a.order - b.order,
      newest: (a, b) => b.id - a.id,
      discount: (a, b) => b.disc - a.disc || a.pmin - b.pmin,
      name: (a, b) => a.name.localeCompare(b.name, lang),
    };
    const resultsText = (n: number) => (n === 1 ? text.results1 : text.results).replace('{n}', String(n));

    /* ---------- Controls exist twice (bar and phone sheet); both always show the same state ---------- */
    const syncControls = () => {
      $$<HTMLInputElement>('[data-ctl] input[type=checkbox]').forEach((i) => {
        i.checked = i.name === 'stock' ? state.stock : i.name === 'sale' ? state.sale : state[i.name as Group].has(i.value);
      });
      $$<HTMLInputElement>('input[name=pmin]').forEach((i) => (i.value = String(state.lo)));
      $$<HTMLInputElement>('input[name=pmax]').forEach((i) => (i.value = String(state.hi)));
      sortOpts.forEach((o) => o.setAttribute('aria-selected', String(o.dataset.sort === state.sort)));
      $('[data-sort-label]')!.textContent = sortOpts.find((o) => o.dataset.sort === state.sort)?.textContent?.trim() ?? '';
      paintRange();
    };
    const paintRange = () => {
      const pct = (v: number) => `${((v - LO) / (HI - LO || 1)) * 100}%`;
      $$('[data-range]').forEach((r) => { r.style.setProperty('--lo', pct(state.lo)); r.style.setProperty('--hi', pct(state.hi)); });
      $$('[data-plo]').forEach((e) => (e.textContent = gel(state.lo)));
      $$('[data-phi]').forEach((e) => (e.textContent = gel(state.hi)));
    };

    /* ---------- Render ---------- */
    const render = (animate = true) => {
      const visible = cells.filter((c) => matches(c));
      const shown = new Set(visible);
      const sorted = [...cells].sort(sorters[state.sort] || sorters.rec);
      cat.append(...sorted.map((c) => c.el));
      let k = 0;
      for (const c of sorted) {
        const on = shown.has(c);
        c.el.hidden = !on;
        c.el.querySelector('.spec')?.classList.add('is-in');
        if (animate && on) {
          c.el.getAnimations().forEach((a) => a.cancel());
          c.el.animate(
            reduce ? [{ opacity: 0 }, { opacity: 1 }] : [{ opacity: 0, transform: 'translateY(10px) scale(0.98)' }, { opacity: 1, transform: 'none' }],
            { duration: reduce ? 200 : 320, delay: Math.min(k++, 8) * 35, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' },
          );
        }
      }

      // Faceted counts: how many results each option would give with the other filters as they are.
      $$<HTMLInputElement>('.opt input').forEach((i) => {
        const g = i.name as Group;
        const n = cells.filter((c) => matches(c, g) && (g === 'size' ? c.sizes.includes(i.value) : (c as any)[g] === i.value)).length;
        const opt = i.closest('.opt')!;
        opt.querySelector('[data-n]')!.textContent = String(n);
        opt.classList.toggle('is-empty', n === 0 && !i.checked);
        i.disabled = n === 0 && !i.checked;
      });

      // Pills say what they hold: one value by name, several by count, price as a range.
      $$<HTMLButtonElement>('[data-pill]').forEach((p) => {
        const g = p.dataset.pill!;
        if (g === 'sort') return;
        const v = p.querySelector<HTMLElement>('[data-pill-v]')!;
        let val = '';
        if (g === 'price') val = priceOn() ? `${gel(state.lo)} – ${gel(state.hi)}` : '';
        else {
          const set = state[g as Group];
          val = set.size === 1 ? text.labels[g][[...set][0]] ?? '' : set.size > 1 ? String(set.size) : '';
        }
        v.textContent = val;
        v.hidden = !val;
        p.classList.toggle('is-on', !!val);
      });

      const active = activeCount();
      $('[data-count]')!.textContent = resultsText(visible.length);
      $$('[data-live]').forEach((e) => (e.textContent = resultsText(visible.length)));
      const badge = $('[data-badge]')!;
      badge.hidden = active === 0;
      badge.textContent = String(active);
      $('[data-none]')!.hidden = visible.length > 0;
      cat.hidden = visible.length === 0;
      $('[data-show]')!.textContent = text.show.replace('{n}', String(visible.length));
      $$<HTMLButtonElement>('[data-reset]').forEach((b) => (b.disabled = active === 0 && state.sort === 'rec'));
      $$<HTMLButtonElement>('[data-clear]').forEach((b) => {
        const g = b.dataset.clear!;
        b.disabled = g === 'price' ? !priceOn() : !state[g as Group].size;
      });
      renderChips(active);
      write();
    };

    const renderChips = (active: number) => {
      const chips: { k: string; v: string; drop: () => void }[] = [];
      for (const g of ['type', 'dim', 'mat', 'size'] as Group[]) {
        for (const v of state[g]) chips.push({ k: text[g], v: text.labels[g]?.[v] ?? v, drop: () => state[g].delete(v) });
      }
      if (priceOn()) chips.push({ k: text.price, v: `${gel(state.lo)} – ${gel(state.hi)}`, drop: () => { state.lo = LO; state.hi = HI; } });
      if (state.stock) chips.push({ k: '', v: text.stock, drop: () => (state.stock = false) });
      if (state.sale) chips.push({ k: '', v: text.sale, drop: () => (state.sale = false) });
      $('[data-active]')!.hidden = active === 0;
      $('[data-chips]')!.replaceChildren(...chips.map((c) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chip';
        b.setAttribute('aria-label', `${text.remove}: ${c.k ? c.k + ' — ' : ''}${c.v}`);
        b.innerHTML = `${c.k ? '<span class="chip-k"></span>' : ''}<span class="chip-v"></span><span class="chip-x" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></span>`;
        if (c.k) b.querySelector('.chip-k')!.textContent = `${c.k}:`;
        b.querySelector('.chip-v')!.textContent = c.v;
        b.addEventListener('click', () => { c.drop(); syncControls(); render(); });
        li.append(b);
        return li;
      }));
    };

    /* ---------- Inputs ---------- */
    shop.addEventListener('change', (e) => {
      const i = e.target as HTMLInputElement;
      if (i.type !== 'checkbox' || !i.closest('[data-ctl]')) return;
      if (i.name === 'stock') state.stock = i.checked;
      else if (i.name === 'sale') state.sale = i.checked;
      else { const g = state[i.name as Group]; i.checked ? g.add(i.value) : g.delete(i.value); }
      syncControls();
      render();
    });
    // Price: the readout follows the handle live; results update when it is let go.
    $$<HTMLElement>('[data-range]').forEach((r) => {
      const lo = r.querySelector<HTMLInputElement>('[name=pmin]')!, hi = r.querySelector<HTMLInputElement>('[name=pmax]')!;
      const move = (commit: boolean, from: HTMLInputElement) => {
        let a = Number(lo.value), b = Number(hi.value);
        if (a > b) { if (from === lo) a = b; else b = a; }
        state.lo = a; state.hi = b;
        lo.value = String(a); hi.value = String(b);
        // Keep the min handle on top when both sit at the right end, so they can always be pulled apart.
        lo.style.zIndex = a >= HI - (HI - LO) * 0.05 ? '2' : '1';
        paintRange();
        if (commit) { syncControls(); render(); }
      };
      for (const el of [lo, hi]) {
        el.addEventListener('input', () => move(false, el));
        el.addEventListener('change', () => move(true, el));
      }
    });
    // Custom sort list: click or keyboard (arrows, Home/End, Enter/Space, Escape via the popover).
    const choose = (k: string) => {
      sortPop.hidePopover();
      requestAnimationFrame(() => sortBtn.focus({ preventScroll: true }));
      if (k === state.sort) return;
      state.sort = k;
      syncControls();
      render();
    };
    sortOpts.forEach((o) => o.addEventListener('click', () => choose(o.dataset.sort!)));
    sortPop.addEventListener('keydown', (e) => {
      const cur = sortOpts.indexOf(document.activeElement as HTMLElement);
      // Without focus inside the list yet, arrows start from the current choice.
      const i = cur >= 0 ? cur : sortOpts.findIndex((o) => o.dataset.sort === state.sort);
      const go = (n: number) => { e.preventDefault(); sortOpts[(n + sortOpts.length) % sortOpts.length].focus(); };
      if (e.key === 'ArrowDown') go(i + 1);
      else if (e.key === 'ArrowUp') go(i - 1);
      else if (e.key === 'Home') go(0);
      else if (e.key === 'End') go(sortOpts.length - 1);
      else if ((e.key === 'Enter' || e.key === ' ') && cur >= 0) { e.preventDefault(); choose(sortOpts[cur].dataset.sort!); }
    });
    // Opening the list puts focus on the current choice, so arrows start from there.
    sortPop.addEventListener('toggle', (e: any) => {
      if (e.newState === 'open') requestAnimationFrame(() => (sortOpts.find((o) => o.dataset.sort === state.sort) ?? sortOpts[0])?.focus({ preventScroll: true }));
    });
    sortBtn.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); sortPop.showPopover(); }
    });
    $$<HTMLButtonElement>('[data-clear]').forEach((b) => b.addEventListener('click', () => {
      const g = b.dataset.clear!;
      if (g === 'price') { state.lo = LO; state.hi = HI; } else state[g as Group].clear();
      syncControls();
      render();
    }));
    const reset = () => {
      state.type.clear(); state.dim.clear(); state.mat.clear(); state.size.clear();
      state.lo = LO; state.hi = HI; state.stock = false; state.sale = false; state.sort = 'rec';
      syncControls();
      render();
    };
    $$<HTMLButtonElement>('[data-reset]').forEach((b) => b.addEventListener('click', reset));

    /* ---------- Popovers: anchored under their pill, kept on screen ---------- */
    const pops = $$<HTMLElement>('[data-pop]');
    const place = (pop: HTMLElement) => {
      const vw = document.documentElement.clientWidth;
      const pill = $<HTMLElement>(`[data-pill="${pop.dataset.pop}"]`)!;
      const r = pill.getBoundingClientRect();
      const end = pop.dataset.align === 'end';
      pop.style.top = `${Math.round(r.bottom + 8)}px`;
      // No width is known before the popover opens, so anchor one edge and cap the width to the room on that side.
      if (end) {
        pop.style.left = 'auto';
        pop.style.right = `${Math.round(Math.max(12, vw - r.right))}px`;
        pop.style.maxWidth = `${Math.round(Math.min(r.right, vw) - 12)}px`;
        pop.style.minWidth = `${Math.round(Math.min(r.width, vw - 24))}px`;
        pop.style.setProperty('--origin', 'top right');
      } else {
        const left = Math.max(12, Math.min(r.left, vw - 252));
        pop.style.right = 'auto';
        pop.style.left = `${Math.round(left)}px`;
        pop.style.maxWidth = `${Math.round(vw - left - 12)}px`;
        pop.style.setProperty('--origin', 'top left');
      }
    };
    for (const pop of pops) {
      pop.addEventListener('beforetoggle', (e: any) => { if (e.newState === 'open') place(pop); });
      pop.addEventListener('toggle', (e: any) => {
        $(`[data-pill="${pop.dataset.pop}"]`)?.setAttribute('aria-expanded', String(e.newState === 'open'));
      });
    }
    const reposition = () => pops.forEach((p) => { if (p.matches(':popover-open')) place(p); });
    addEventListener('scroll', reposition, { passive: true });
    addEventListener('resize', reposition, { passive: true });

    /* ---------- Phone sheet ---------- */
    const opener = $<HTMLButtonElement>('[data-f-open]')!;
    opener.addEventListener('click', () => sheet.showModal());
    sheet.addEventListener('close', () => opener.focus({ preventScroll: true }));
    $('[data-sheet-close]')!.addEventListener('click', () => sheet.close());
    $('[data-sheet-done]')!.addEventListener('click', () => { sheet.close(); shop.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' }); });
    sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
    matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches && sheet.open) sheet.close(); });

    // Opening a product remembers where the visitor was in the catalogue (restored in Base.astro).
    cat.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('a[href]')) return;
      try { sessionStorage.setItem('symmetry:catalogue', JSON.stringify({ url: location.pathname + location.search, y: scrollY, t: Date.now() })); } catch {}
    });

    read();
    syncControls();
    render(false);
  }
</script>
