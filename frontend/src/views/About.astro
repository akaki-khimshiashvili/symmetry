---
/*
DIRECTION (About)
Thesis: "Form in motion". The page reads like a calm studio statement; the only image is the idea
itself, contour lines flowing through a parametric field, so the brand's subject (computed form)
is shown rather than photographed.
Hero focal asset: one Three.js shader canvas (flowfield.ts), pointer bends the lines; static
gradient poster underneath for reduced motion / no WebGL. No raster images, no people.
Type: FiraGO throughout. Headline capped near 3.4rem; statements at --t-xl; body at --t-base.
Colour: oak palette tokens only (ground, ground-2, ink, wood-lo).
Sequence: hero > philosophy (scroll-lit words) > approach (three steps, hairlines draw) >
what we make (plain list, no links) > sign-off (approach line, wordmark, tagline).
Motion: GSAP + ScrollTrigger; Lenis is the single smooth-scroll engine, this page only.
Reduced motion: no Lenis, no canvas, no scrub; everything renders in its final state.
Provenance: all visuals are code (shader + CSS hairlines); no third-party media.
*/
import Base from '../layouts/Base.astro';
import { type Lang, useT } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const words = (s: string) => s.split(/\s+/).filter(Boolean);
const steps = [t('about.pillar1'), t('about.pillar2'), t('about.pillar3')];
const works = [t('about.work1'), t('about.work2'), t('about.work3')];
const two = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} title={t('about.title')} current="about">
  <script is:inline>
    // Hide the hero words only while the intro is about to run; never longer than 2.5s.
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var h = document.documentElement;
      h.classList.add('ab-pending');
      setTimeout(function () { h.classList.remove('ab-pending'); }, 2500);
    })();
  </script>

  <section class="ab-hero" data-ab-hero>
    <div class="ab-canvas" data-ab-canvas></div>
    <div class="wrap ab-hero-in">
      <p class="label ab-eyebrow" data-ab-intro>{t('about.title')}</p>
      <h1 class="ab-title" data-ab-split>
        <span class="sr-only">{t('about.headline')}</span>
        <span aria-hidden="true">{words(t('about.headline')).map((w) => <><span class="w"><span class="wi">{w}</span></span>{' '}</>)}</span>
      </h1>
      <p class="ab-lead" data-ab-intro>{t('about.lead')}</p>
    </div>
    <span class="ab-scroll label" aria-hidden="true" data-ab-intro><span class="ab-scroll-line"></span>{t('about.scroll')}</span>
  </section>

  <section class="wrap ab-sec ab-belief">
    <p class="label ab-k">{t('about.beliefLabel')}</p>
    <p class="ab-statement" data-ab-lit>
      <span class="sr-only">{t('about.belief')}</span>
      <span aria-hidden="true">{words(t('about.belief')).map((w) => <span class="lw">{w} </span>)}</span>
    </p>
  </section>

  <section class="wrap ab-sec ab-approach">
    <p class="label ab-k">{t('about.craftLabel')}</p>
    <div class="ab-col">
      <p class="ab-body" data-ab-up>{t('about.craft')}</p>
      <ol class="ab-steps">
        {steps.map((s, i) => (
          <li data-ab-step>
            <span class="ab-rule" aria-hidden="true"><span></span></span>
            <span class="ab-n num">{two(i + 1)}</span>
            <span class="ab-step">{s}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap ab-sec ab-works">
    <p class="label ab-k">{t('about.worksLabel')}</p>
    <div class="ab-col">
      <p class="ab-body" data-ab-up>{t('about.projects')}</p>
      <ul class="ab-rows">
        {works.map((w, i) => (
          <li data-ab-up>
            <div class="ab-row">
              <span class="ab-n num">{two(i + 1)}</span>
              <span class="ab-row-name">{w}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap ab-sign">
    <p class="ab-body ab-approach-line" data-ab-up>{t('about.approach')}</p>
    <p class="ab-mark" data-ab-mark>
      <span class="sr-only">Symmetry</span>
      <span aria-hidden="true">{'Symmetry'.split('').map((c) => <span class="ch">{c}</span>)}</span>
    </p>
    <p class="ab-tagline" data-ab-up>{t('about.tagline')}</p>
  </section>

</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  gsap.registerPlugin(ScrollTrigger);
  const html = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const q = <T extends Element = HTMLElement>(s: string) => Array.from(document.querySelectorAll<T>(s));
  const cleanups: Array<() => void> = [];

  const hero = document.querySelector<HTMLElement>('[data-ab-hero]')!;
  const host = document.querySelector<HTMLElement>('[data-ab-canvas]')!;

  if (reduce) {
    html.classList.remove('ab-pending');
  } else {
    // Smooth scroll: Lenis drives native scroll, ScrollTrigger reads it through the GSAP ticker.
    const lenis = new Lenis({ lerp: 0.11, wheelMultiplier: 0.95 });
    lenis.on('scroll', ScrollTrigger.update);
    const tick = (time: number) => lenis.raf(time * 1000);
    gsap.ticker.add(tick);
    gsap.ticker.lagSmoothing(0);
    cleanups.push(() => { gsap.ticker.remove(tick); lenis.destroy(); });

    // Shader backdrop, loaded after first paint; the poster stays if WebGL is unavailable.
    const hasGL = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
    if (hasGL) {
      import('../lib/flowfield').then(({ mountFlowField }) => {
        const dispose = mountFlowField(host, {
          onReady: () => host.classList.add('is-live'),
          onFail: () => host.classList.remove('is-live'),
        });
        cleanups.push(dispose);
      });
    }

    // Hero intro: words rise in, then lead and actions. Content is usable throughout.
    const wordsIn = q('[data-ab-split] .wi');
    gsap.set(wordsIn, { y: 0, yPercent: 110 });
    html.classList.remove('ab-pending');
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.from('.ab-eyebrow', { opacity: 0, y: 8, duration: 0.6 })
      .to(wordsIn, { yPercent: 0, duration: 1.1, stagger: 0.06, clearProps: 'transform' }, 0.1)
      .from('.ab-lead, .ab-scroll', { opacity: 0, y: 14, duration: 0.9, stagger: 0.08 }, 0.45);

    // Hero copy drifts up and fades slightly as the page scrolls away.
    gsap.to('.ab-hero-in', {
      yPercent: -12, opacity: 0.35, ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });

    // Philosophy: words light up as the statement passes the reading line.
    gsap.fromTo('[data-ab-lit] .lw', { opacity: 0.16 }, {
      opacity: 1, stagger: 0.08, ease: 'none',
      scrollTrigger: { trigger: '[data-ab-lit]', start: 'top 80%', end: 'bottom 45%', scrub: 0.6 },
    });

    // Approach steps: hairlines draw left to right, labels follow.
    q('[data-ab-step]').forEach((li, i) => {
      gsap.timeline({ scrollTrigger: { trigger: li, start: 'top 88%' } })
        .from(li.querySelector('.ab-rule span'), { scaleX: 0, duration: 1.2, ease: 'expo.inOut', delay: i * 0.12 })
        .from(li.querySelectorAll('.ab-n, .ab-step'), { opacity: 0, y: 10, duration: 0.7, stagger: 0.06, ease: 'power3.out' }, '-=0.7');
    });

    // Supporting copy and rows.
    q('[data-ab-up]').forEach((el) => {
      gsap.from(el, { opacity: 0, y: 24, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 90%' } });
    });

    // Wordmark letters settle in from a wider spacing.
    gsap.from('[data-ab-mark] .ch', {
      opacity: 0, yPercent: 40, stagger: 0.04, duration: 0.9, ease: 'expo.out',
      scrollTrigger: { trigger: '[data-ab-mark]', start: 'top 85%' },
    });

    // Fonts can change line breaks; re-measure once they settle.
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  addEventListener('pagehide', () => {
    cleanups.splice(0).forEach((fn) => fn());
    ScrollTrigger.getAll().forEach((st) => st.kill());
  }, { once: true });
</script>

<style>
  /* ---------- Hero ---------- */
  .ab-hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: min(calc(100svh - var(--header-h)), 860px);
    display: grid; align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .ab-canvas {
    position: absolute; inset: 0; z-index: -1;
    /* Static poster: the field's calm tonal wash, shown until (or instead of) the shader. */
    background:
      radial-gradient(70% 90% at 85% 40%, var(--ground-2), transparent 70%),
      radial-gradient(40% 60% at 100% 100%, var(--ground-3), transparent 70%),
      var(--ground);
  }
  .ab-canvas :global(canvas) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; transition: opacity 1.4s var(--ease-out);
  }
  .ab-canvas:global(.is-live) :global(canvas) { opacity: 1; }

  .ab-hero-in { display: grid; gap: var(--s-3); padding-block: var(--s-5); }
  .ab-eyebrow { color: var(--ink-3); }
  .ab-title {
    font-family: var(--f-display); font-weight: 500; letter-spacing: var(--track-display);
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); line-height: 1.12;
    max-width: 16ch; text-wrap: balance;
  }
  :lang(ka) .ab-title { max-width: 20ch; line-height: 1.25; }
  .ab-title .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.08em; }
  .ab-title .wi { display: inline-block; }
  :global(html.ab-pending) .ab-title .wi { opacity: 0; }
  .ab-lead { max-width: 46ch; color: var(--ink-2); font-size: var(--t-lg); line-height: 1.6; }

  .ab-scroll {
    position: absolute; left: max(var(--margin), calc((100% - var(--max)) / 2 + var(--margin))); bottom: var(--s-3);
    display: inline-flex; align-items: center; gap: 0.75rem; color: var(--ink-3);
  }
  .ab-scroll-line { width: 2.5rem; height: 1px; background: currentColor; transform-origin: left; animation: ab-cue 2.8s var(--ease-in-out) infinite; }
  @keyframes ab-cue { 0% { transform: scaleX(0); } 50% { transform: scaleX(1); } 100% { transform: scaleX(1); opacity: 0; } }

  /* ---------- Sections ---------- */
  .ab-sec {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s-3);
    padding-block: var(--s-5);
  }
  .ab-sec + .ab-sec { border-top: 1px solid var(--line); }
  .ab-k { grid-column: 1 / span 3; color: var(--ink-3); padding-top: 0.4em; }
  .ab-col, .ab-statement { grid-column: 4 / -1; }
  .ab-col { display: grid; gap: var(--s-4); }
  .ab-body { max-width: 60ch; color: var(--ink-2); font-size: var(--t-lg); line-height: 1.65; text-wrap: pretty; }

  .ab-belief { padding-block: var(--s-6) var(--s-5); }
  .ab-statement {
    font-family: var(--f-display); font-weight: 500; letter-spacing: -0.01em;
    font-size: clamp(1.45rem, 1.05rem + 1.4vw, 2.2rem); line-height: 1.38; max-width: 30ch; text-wrap: pretty;
  }
  :lang(ka) .ab-statement { line-height: 1.5; }

  .ab-steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .ab-steps li { display: grid; gap: 0.6rem; align-content: start; }
  .ab-rule { display: block; height: 1px; background: var(--line); margin-bottom: 0.6rem; }
  .ab-rule span { display: block; height: 100%; background: var(--ink); transform-origin: left; }
  .ab-n { font-size: var(--t-xs); letter-spacing: 0.12em; color: var(--ink-3); }
  .ab-step { font-weight: 600; font-size: var(--t-base); color: var(--ink); }

  .ab-rows { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .ab-rows li { border-bottom: 1px solid var(--line); }
  .ab-row {
    display: grid; grid-template-columns: 3rem 1fr; align-items: center; gap: var(--s-2);
    padding-block: 1.25rem; color: var(--ink);
  }
  .ab-row-name { font-size: var(--t-lg); line-height: 1.4; }

  /* ---------- Sign-off ---------- */
  .ab-sign {
    display: grid; justify-items: center; text-align: center; gap: var(--s-2);
    padding-block: var(--s-6); border-top: 1px solid var(--line);
  }
  .ab-approach-line { max-width: 52ch; margin-bottom: var(--s-3); }
  .ab-mark {
    font-family: var(--f-display); font-weight: 500; letter-spacing: -0.02em;
    font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.6rem); line-height: 1;
  }
  .ab-mark .ch { display: inline-block; }
  .ab-tagline { color: var(--ink-3); }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .ab-k, .ab-col, .ab-statement { grid-column: 1 / -1; }
    .ab-steps { grid-template-columns: 1fr; gap: var(--s-3); }
    .ab-hero { align-items: start; }
    .ab-hero-in { padding-top: var(--s-4); padding-bottom: calc(var(--s-6) + 2rem); }
  }
  @media (max-width: 560px) {
    .ab-row { grid-template-columns: 2.25rem 1fr; padding-block: 1rem; }
    .ab-row-name { font-size: var(--t-base); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ab-scroll-line { animation: none; }
  }
</style>
