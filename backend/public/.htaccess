RewriteEngine On
# No directory listings (uploads/ in particular).
Options -Indexes
# Pass the Authorization header through to PHP (needed on some Apache setups)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(/.*)?$ index.php [QSA,L]

# Only the front controller runs as PHP; nothing else here (or in uploads/) is ever executed.
<FilesMatch "\.(php|phtml|phar|php\d)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
# Dotfiles (this file included) are never served.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
